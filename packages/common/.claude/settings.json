{
  "permissions": {
    "allow": [
      "Read(**/.env.example)",
      "Bash(claude-afk)",
      "Bash(claude-back)",
      "Bash(timeout:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(/Users/stefan/Documents/Private/**)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0,
    "refreshInterval": 1
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "theme": "dark",
  "agentPushNotifEnabled": true
}
