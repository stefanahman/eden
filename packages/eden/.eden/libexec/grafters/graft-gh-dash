#!/bin/bash
# graft-gh-dash - Compose ~/.config/gh-dash/config.yml from branches.
# Part of Eden's pluggable grafter system.
#
# gh-dash has no native config include/merge: one file or nothing. Splitting
# work and personal repoPaths across branches means we have to produce one
# composed file at graft time. Each branch contributes:
#
#   <branch>/.config/gh-dash/base.yml       — sections, defaults, keybindings.
#                                             Exactly one branch should own this
#                                             (typically `common`).
#   <branch>/.config/gh-dash/repoPaths.yml  — owner/repo → path entries
#                                             contributed by this branch.
#                                             Don't include the `repoPaths:`
#                                             header — the grafter wraps them.
#
# Result: a single real file at ~/.config/gh-dash/config.yml that concatenates
# the base with a `repoPaths:` block built from every branch's entries.
set -e
trap 'echo "  !! graft-gh-dash failed at line $LINENO" >&2' ERR

if [[ "${1:-}" == "--api-version" ]]; then
    echo 1
    exit 0
fi

# Report covered paths for eden doctor
if [[ "${1:-}" == "--covers" ]]; then
    echo ".config/gh-dash/config.yml"
    exit 0
fi

# Detect Eden root from script location
if [[ -z "$EDEN_ROOT" ]]; then
    SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
    EDEN_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/../../../../.." && pwd)"
fi

expand_branch_path() {
    local path="$1"
    path="${path//\$EDEN_ROOT/$EDEN_ROOT}"
    path="${path/#\~/$HOME}"
    echo "$path"
}

echo "  → Grafting gh-dash config from branches"

BRANCHES_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/eden/branches"
if [[ ! -f "$BRANCHES_FILE" ]]; then
    echo "  ⚠ No branches file found"
    exit 0
fi

OUT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/gh-dash"
OUT="$OUT_DIR/config.yml"
mkdir -p "$OUT_DIR"

BASE=""
BASE_BRANCH=""
REPOPATH_FILES=()
REPOPATH_BRANCHES=()

while IFS= read -r branch_path; do
    [[ -z "$branch_path" ]] && continue
    [[ "$branch_path" =~ ^[[:space:]]*# ]] && continue

    branch_path=$(expand_branch_path "$branch_path")
    branch_name=$(basename "$branch_path")
    [[ -d "$branch_path" ]] || continue

    branch_base="$branch_path/.config/gh-dash/base.yml"
    branch_rp="$branch_path/.config/gh-dash/repoPaths.yml"

    if [[ -f "$branch_base" ]]; then
        if [[ -n "$BASE" ]]; then
            echo "  !! multiple base.yml found (was: $BASE_BRANCH, now: $branch_name) — ignoring $branch_name" >&2
        else
            BASE="$branch_base"
            BASE_BRANCH="$branch_name"
        fi
    fi
    if [[ -f "$branch_rp" ]]; then
        REPOPATH_FILES+=("$branch_rp")
        REPOPATH_BRANCHES+=("$branch_name")
    fi
done < "$BRANCHES_FILE"

if [[ -z "$BASE" ]]; then
    echo "  → No gh-dash base.yml in any branch — skipping"
    exit 0
fi

# Replace any existing config (symlink or real file) at the target.
[[ -e "$OUT" || -L "$OUT" ]] && rm -f "$OUT"

{
    echo "# Auto-generated by eden's graft-gh-dash. DO NOT EDIT —"
    echo "# edit the branch fragments and re-run 'eden grow'."
    echo "#   base:       $BASE_BRANCH branch (.config/gh-dash/base.yml)"
    if (( ${#REPOPATH_FILES[@]} > 0 )); then
        echo "#   repoPaths from: ${REPOPATH_BRANCHES[*]}"
    fi
    echo
    cat "$BASE"
    if (( ${#REPOPATH_FILES[@]} > 0 )); then
        echo
        echo "repoPaths:"
        for i in "${!REPOPATH_FILES[@]}"; do
            f="${REPOPATH_FILES[$i]}"
            b="${REPOPATH_BRANCHES[$i]}"
            echo "  # $b"
            # Indent each non-blank line by two spaces so the fragments slot
            # under `repoPaths:`. Blank lines pass through unchanged.
            sed -E 's/^([^[:space:]])/  \1/' "$f"
        done
    fi
} > "$OUT"

echo "  ✓ Composed gh-dash config from base ($BASE_BRANCH)" \
     "+ ${#REPOPATH_FILES[@]} repoPaths fragment(s) → $OUT"

exit 0
