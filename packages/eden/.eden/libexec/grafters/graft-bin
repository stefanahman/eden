#!/bin/bash
# graft-bin - Symlink binaries from branches to ~/.eden/bin
# Part of Eden's pluggable grafter system
set -e
trap 'echo "  !! graft-bin failed at line $LINENO" >&2' ERR

if [[ "${1:-}" == "--api-version" ]]; then
    echo 1
    exit 0
fi

# Report covered paths for eden doctor
if [[ "${1:-}" == "--covers" ]]; then
    echo ".local/bin"
    exit 0
fi

# Detect Eden root from script location
if [[ -z "$EDEN_ROOT" ]]; then
    SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
    EDEN_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/../../../../.." && pwd)"
fi

# shellcheck source=lib/branches.sh
source "$EDEN_ROOT/lib/branches.sh"
# shellcheck source=lib/collisions.sh
source "$EDEN_ROOT/lib/collisions.sh"

BRANCHES_FILE="$(eden_branches_file)"

# Check if branches file exists
if [ ! -f "$BRANCHES_FILE" ]; then
    echo "  → No branches registered (skipping)"
    exit 0
fi


eden_bin="$HOME/.eden/bin"
added=0
skipped=0
conflicts=()

# Ensure ~/.eden/bin exists
mkdir -p "$eden_bin"

# Clean up broken symlinks (e.g. scripts moved between branches or removed)
for link in "$eden_bin"/*; do
    [ -L "$link" ] && [ ! -e "$link" ] && {
        name=$(basename "$link")
        if [[ "${EDEN_GRAFT_FORCE:-${FORCE:-}}" == "true" ]]; then
            echo "  × $name [removing broken link]"
            rm "$link"
        elif [[ -t 0 ]]; then
            echo -n "  ⚠ $name is a broken link → [r]emove, [s]kip? "
            read -r choice
            case "$choice" in
                r|R) rm "$link"; echo "  × $name removed" ;;
                *)   echo "  → $name skipped" ;;
            esac
        else
            echo "  ⚠ $name is a broken link (run interactively to resolve)"
        fi
    }
done

# graft_all claims|link: walk every branch's .local/bin. With "claims" it
# only lists each target and its branch; with "link" it links. A link
# that points elsewhere was left by an earlier graft (the claims have
# ruled out another branch), so it is replaced.
graft_all() {
    local mode="$1" branch_path branch_name script script_name target

    while IFS= read -r branch_path; do
        [ -d "$branch_path/.local/bin" ] || continue
        branch_name=$(eden_branch_name "$branch_path")

        for script in "$branch_path/.local/bin"/*; do
            [ -f "$script" ] || continue  # Skip directories and empty globs

            script_name=$(basename "$script")
            target="$eden_bin/$script_name"

            if [[ "$mode" == claims ]]; then
                printf '%s\t%s\n' "$(eden_home_path "$target")" "$branch_name"
                continue
            fi

            if [ -L "$target" ] && [ "$(readlink "$target")" = "$script" ]; then
                echo "  ✓ $script_name ($branch_name) [already linked]"
                skipped=$((skipped + 1))
                continue
            elif [ -e "$target" ] && [ ! -L "$target" ]; then
                conflicts+=("$script_name: file exists (not a symlink)")
                continue
            fi

            ln -sfn "$script" "$target"
            echo "  → $script_name ($branch_name)"
            added=$((added + 1))
        done
    done < <(eden_graft_roots)
}

graft_all claims | eden_check_collisions || exit 1
graft_all link

# Report results
if [ $added -gt 0 ]; then
    echo "  → Grafted $added new binary(ies)"
fi
[ $skipped -gt 0 ] && echo "  → Skipped $skipped already grafted"

# Report conflicts
if [ ${#conflicts[@]} -gt 0 ]; then
    echo "  ⚠ Conflicts detected:"
    for conflict in "${conflicts[@]}"; do
        echo "    • $conflict"
    done
fi

if [ $added -eq 0 ] && [ $skipped -eq 0 ] && [ ${#conflicts[@]} -eq 0 ]; then
    echo "  → No binaries found in branches"
fi

exit 0

