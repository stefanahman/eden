#!/bin/bash
# graft-git - Integrate git identities from branches
# Part of Eden's pluggable grafter system
#
# Branches provide identities at .config/git/identities/<name>
# This grafter symlinks them and generates include directives.
#
# Special identity: _default — unconditional include, provides fallback
# identity for repos no other identity matches.
# Any other identity names the remotes it applies to, one pattern per line:
#
#   [eden]
#       remote = git@github.com:example-corp/**
#       remote = https://github.com/example-corp/**
#
# and is included with includeIf "hasconfig:remote.*.url:<pattern>" (git ≥
# 2.36; an included file must not set a remote URL itself). An identity
# naming no remotes applies by directory: includeIf
# "gitdir:~/Development/<name>/".
set -e
trap 'echo "  !! graft-git failed at line $LINENO" >&2' ERR

if [[ "${1:-}" == "--api-version" ]]; then
    echo 1
    exit 0
fi

# Report covered paths for eden doctor
if [[ "${1:-}" == "--covers" ]]; then
    echo ".config/git"
    exit 0
fi

# Detect Eden root from script location
if [[ -z "$EDEN_ROOT" ]]; then
    SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
    EDEN_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/../../../../.." && pwd)"
fi

# shellcheck source=lib/branches.sh
source "$EDEN_ROOT/lib/branches.sh"
# shellcheck source=lib/collisions.sh
source "$EDEN_ROOT/lib/collisions.sh"

if ! eden_branch_list_exists; then
    echo "  → No branches registered (skipping)"
    exit 0
fi

IDENTITIES_DIR="$HOME/.config/git/identities"
GITCONFIG_LOCAL="${XDG_CONFIG_HOME:-$HOME/.config}/eden/local/gitconfig"

added=0
has_default=""
scoped_directives=""

# graft_all claims|link: with "claims" only list each identity target and
# its branch; with "link" link the identities and collect the directives.
# A link that points elsewhere was left by an earlier graft (the claims
# have ruled out another branch), so it is replaced.
graft_all() {
    local mode="$1" branch_path branch_name identity_file name target remotes pattern

    while IFS= read -r branch_path; do
        [[ -d "$branch_path/.config/git/identities" ]] || continue
        branch_name=$(eden_branch_name "$branch_path")

        for identity_file in "$branch_path/.config/git/identities"/*; do
            [[ -f "$identity_file" ]] || continue

            name=$(basename "$identity_file")
            target="$IDENTITIES_DIR/$name"

            if [[ "$mode" == claims ]]; then
                printf '%s\t%s\n' "$(eden_home_path "$target")" "$branch_name"
                continue
            fi

            if [[ -L "$target" && "$(readlink "$target")" == "$identity_file" ]]; then
                echo "  ✓ identity/$name ($branch_name) [already linked]"
            else
                ln -sfn "$identity_file" "$target"
                echo "  → identity/$name ($branch_name)"
            fi

            if [[ "$name" == "_default" ]]; then
                has_default="$branch_name"
            else
                remotes="$(git config -f "$identity_file" --get-all eden.remote 2>/dev/null)" || remotes=""
                if [[ -n "$remotes" ]]; then
                    while IFS= read -r pattern; do
                        scoped_directives+="
# $name identity (from $branch_name branch), for remote $pattern
[includeIf \"hasconfig:remote.*.url:$pattern\"]
	path = ~/.config/git/identities/$name
"
                    done <<< "$remotes"
                else
                    scoped_directives+="
# $name identity (from $branch_name branch)
[includeIf \"gitdir:~/Development/$name/\"]
	path = ~/.config/git/identities/$name
"
                fi
                added=$((added + 1))
            fi
        done
    done < <(eden_graft_roots)
}

graft_all claims | eden_check_collisions || exit 1

mkdir -p "$IDENTITIES_DIR"
mkdir -p "$(dirname "$GITCONFIG_LOCAL")"
graft_all link

# Write gitconfig: _default first (fallback), then scoped overrides
cat > "$GITCONFIG_LOCAL" << 'EOF'
# Local git configuration - auto-generated by 'eden graft'
# Contains include directives for git identities from branches
# DO NOT EDIT — regenerated on every 'eden graft'
EOF

if [[ -n "$has_default" ]]; then
    cat >> "$GITCONFIG_LOCAL" << EOF

# Default identity (from $has_default branch)
[include]
	path = ~/.config/git/identities/_default
EOF
    added=$((added + 1))
fi

if [[ -n "$scoped_directives" ]]; then
    echo "$scoped_directives" >> "$GITCONFIG_LOCAL"
fi

if [[ $added -gt 0 ]]; then
    echo "  → Grafted $added git identity(ies)"
else
    echo "  → No git identities found in branches"
fi

exit 0
