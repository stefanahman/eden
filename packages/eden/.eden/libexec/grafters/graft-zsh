#!/bin/bash
# graft-zsh - Graft zsh configs from branches (zshenv.d/, zshrc.d/)
# Part of Eden's pluggable grafter system
set -e
trap 'echo "  !! graft-zsh failed at line $LINENO" >&2' ERR

if [[ "${1:-}" == "--api-version" ]]; then
    echo 1
    exit 0
fi

# Report covered paths for eden doctor
if [[ "${1:-}" == "--covers" ]]; then
    echo ".config/zsh/zshenv.d"
    exit 0
fi

# Detect Eden root from script location
if [[ -z "$EDEN_ROOT" ]]; then
    SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
    EDEN_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/../../../../.." && pwd)"
fi

echo "  → Grafting zsh configs from branches"

# Graft zsh configs from each branch
# shellcheck source=lib/branches.sh
source "$EDEN_ROOT/lib/branches.sh"
# shellcheck source=lib/collisions.sh
source "$EDEN_ROOT/lib/collisions.sh"

BRANCHES_FILE="$(eden_branches_file)"
if [[ ! -f "$BRANCHES_FILE" ]]; then
    echo "  ⚠ No branches file found"
    exit 0
fi

ZSHENV_D="${XDG_CONFIG_HOME:-$HOME/.config}/zsh/zshenv.d"
GRAFTED_COUNT=0

# graft_all claims|link: with "claims" only list each target and its
# branch; with "link" link every .zsh file from each branch's zshenv.d/.
graft_all() {
    local mode="$1" branch_path branch_name file target

    while IFS= read -r branch_path; do
        [[ -d "$branch_path/.config/zsh/zshenv.d" ]] || continue
        branch_name=$(eden_branch_name "$branch_path")

        if [[ "$mode" == link ]]; then
            echo "  → Grafting zsh from: $branch_name"
            mkdir -p "$ZSHENV_D"
            GRAFTED_COUNT=$((GRAFTED_COUNT + 1))
        fi

        for file in "$branch_path/.config/zsh/zshenv.d"/*.zsh; do
            [[ -e "$file" ]] || continue
            target="$ZSHENV_D/$(basename "$file")"
            if [[ "$mode" == claims ]]; then
                printf '%s\t%s\n' "$(eden_home_path "$target")" "$branch_name"
            else
                ln -sfn "$file" "$target"
            fi
        done
    done < <(eden_graft_roots)
}

graft_all claims | eden_check_collisions || exit 1
graft_all link

if [[ $GRAFTED_COUNT -eq 0 ]]; then
    echo "  → No zsh configs found in branches"
else
    echo "  → Grafted zsh from $GRAFTED_COUNT branch(es)"
fi

exit 0

