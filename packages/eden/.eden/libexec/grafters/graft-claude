#!/bin/bash
# graft-claude - Symlink Claude Code configs from branches
#
# Grafts two scopes:
#   1. Global: .claude/{rules,agents,commands,output-styles,skills}/ +
#      .claude/{settings.json,statusline.sh,CLAUDE.md,*.local.md} → ~/.claude/
#   2. Project: projects/<path>/.claude/{...same shape...} → <target>/.claude/
#      where <target> is read from projects/<path>/.eden-target
#      Any directory nesting is allowed (e.g. projects/games/greenwash/)
#
# Part of Eden's pluggable grafter system
set -e
trap 'echo "  !! graft-claude failed at line $LINENO" >&2' ERR

if [[ "${1:-}" == "--api-version" ]]; then
    echo 1
    exit 0
fi

# Report covered paths for eden doctor
if [[ "${1:-}" == "--covers" ]]; then
    echo ".claude"
    exit 0
fi

# Detect Eden root from script location
if [[ -z "$EDEN_ROOT" ]]; then
    SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
    EDEN_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/../../../../.." && pwd)"
fi

# shellcheck source=lib/branches.sh
source "$EDEN_ROOT/lib/branches.sh"
# shellcheck source=lib/collisions.sh
source "$EDEN_ROOT/lib/collisions.sh"

BRANCHES_FILE="$(eden_branches_file)"

if [[ ! -f "$BRANCHES_FILE" ]]; then
    echo "  → No branches registered (skipping)"
    exit 0
fi

added=0
skipped=0
conflicts=()

# MODE is "claims" while the targets are listed and checked for collisions,
# then "link". A link that points elsewhere was left by an earlier graft
# (the claims have ruled out another branch), so it is replaced.
MODE="claims"

# _graft_link <source> <target> <owner> <label>: claim or link one entry.
_graft_link() {
    local source="$1" target="$2" owner="$3" label="$4"

    if [[ "$MODE" == claims ]]; then
        printf '%s\t%s\n' "$(eden_home_path "$target")" "$owner"
        return 0
    fi

    # Compared resolved, so a link spelled another way (a // in the path,
    # a symlinked folder on the way) still counts as the same.
    if [[ -L "$target" && "$(readlink -f "$target" 2>/dev/null || readlink "$target")" == "$(readlink -f "$source" 2>/dev/null || printf '%s' "$source")" ]]; then
        echo "  ✓ $label ($owner) [already linked]"
        skipped=$((skipped + 1))
        return 0
    elif [[ -e "$target" && ! -L "$target" ]]; then
        conflicts+=("$label: exists and is not a symlink — remove it to graft")
        return 0
    fi

    mkdir -p "$(dirname "$target")"
    ln -sfn "$source" "$target"
    echo "  → $label ($owner)"
    added=$((added + 1))
}

# Graft flat markdown files (rules/, agents/, commands/, output-styles/)
_graft_flat_dir() {
    local source_dir="$1" target_dir="$2" kind="$3" owner="$4" file

    [[ -d "$source_dir" ]] || return 0
    for file in "$source_dir"/*.md; do
        [[ -e "$file" ]] || continue
        _graft_link "$file" "$target_dir/${file##*/}" "$owner" "$kind/${file##*/}"
    done
}

# Graft skill directories (each skill is a directory with SKILL.md)
_graft_skills_dir() {
    local source_dir="$1" target_dir="$2" owner="$3" skill_dir skill_name

    [[ -d "$source_dir" ]] || return 0
    for skill_dir in "$source_dir"/*/; do
        [[ -d "$skill_dir" ]] || continue
        skill_name=$(basename "$skill_dir")
        _graft_link "${skill_dir%/}" "$target_dir/$skill_name" "$owner" "skills/$skill_name"
    done
}

# Graft a single top-level file inside .claude/ (e.g. settings.json, statusline.sh)
_graft_top_file() {
    local source_file="$1" target_file="$2" owner="$3" name="$4"

    [[ -e "$source_file" ]] || return 0
    _graft_link "$source_file" "$target_file" "$owner" "$name"
}

# Graft all Claude configs from a source .claude/ dir into a target .claude/ dir
_graft_claude_dir() {
    local source_claude="${1%/}" target_claude="${2%/}" owner="$3" kind local_md

    [[ -d "$source_claude" ]] || return 0

    for kind in rules agents commands output-styles; do
        _graft_flat_dir "$source_claude/$kind" "$target_claude/$kind" "$kind" "$owner"
    done
    _graft_skills_dir "$source_claude/skills" "$target_claude/skills" "$owner"
    _graft_top_file "$source_claude/settings.json" "$target_claude/settings.json" "$owner" "settings.json"
    _graft_top_file "$source_claude/statusline.sh" "$target_claude/statusline.sh" "$owner" "statusline.sh"
    _graft_top_file "$source_claude/CLAUDE.md" "$target_claude/CLAUDE.md" "$owner" "CLAUDE.md"
    # `.claude/<plugin>.local.md` is Claude Code's per-project plugin-settings
    # convention (gitignored in the target, so a branch is where it lives).
    # settings.local.json is deliberately NOT grafted: Claude Code writes to it.
    for local_md in "$source_claude"/*.local.md; do
        _graft_top_file "$local_md" "$target_claude/${local_md##*/}" "$owner" "${local_md##*/}"
    done
}

graft_all() {
    local branch_path branch_name projects_dir target_file project_dir local_name project_target

    while IFS= read -r branch_path; do
        [[ -d "$branch_path" ]] || continue

        branch_name=$(basename "$branch_path")

        # 1. Global scope: branch/.claude/ → ~/.claude/
        _graft_claude_dir "$branch_path/.claude" "$HOME/.claude" "$branch_name"

        # 2. Project scope: discover all .eden-target files under projects/
        projects_dir="$branch_path/projects"
        [[ -d "$projects_dir" ]] || continue
        while IFS= read -r target_file || [[ -n "$target_file" ]]; do
            project_dir=$(dirname "$target_file")
            local_name="${project_dir#"$projects_dir"/}"

            project_target=$(eden_branch_expand "$(head -1 "$target_file" | tr -d '[:space:]')")

            if [[ ! -d "$project_target" ]]; then
                if [[ "$MODE" == link ]]; then
                    echo "  ⚠ projects/$local_name: target $project_target not found (skipping)"
                fi
                continue
            fi

            _graft_claude_dir "$project_dir/.claude" "$project_target/.claude" "$branch_name:$local_name"
        done < <(find "$projects_dir" -name .eden-target -type f || true)
    done < <(eden_branches)
}

graft_all | eden_check_collisions || exit 1
MODE="link"
graft_all

# Report results
if [[ $added -gt 0 ]]; then
    echo "  → Grafted $added Claude config(s)"
fi
[[ $skipped -gt 0 ]] && echo "  → Skipped $skipped already grafted"

if [[ ${#conflicts[@]} -gt 0 ]]; then
    echo "  ⚠ Conflicts detected:"
    for conflict in "${conflicts[@]}"; do
        echo "    • $conflict"
    done
fi

if [[ $added -eq 0 && $skipped -eq 0 && ${#conflicts[@]} -eq 0 ]]; then
    echo "  → No Claude configs found in branches"
fi

exit 0
