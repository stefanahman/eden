#!/bin/bash
# graft-mcp - Merge MCP servers from trunk and branches
#
# Two scopes:
#   1. Global: branch/.config/mcp/servers.json → merged into ~/.config/mcp/servers.json
#   2. Project: branch/projects/<path>/.mcp/servers.json → <target>/.mcp.json (+ client variants)
#      where <target> is read from projects/<path>/.eden-target
#
# Part of Eden's pluggable grafter system
set -e
trap 'echo "  !! graft-mcp failed at line $LINENO" >&2' ERR

if [[ "${1:-}" == "--api-version" ]]; then
    echo 1
    exit 0
fi

# Report covered paths for eden doctor
if [[ "${1:-}" == "--covers" ]]; then
    echo ".config/mcp"
    exit 0
fi

# --force: apply without prompting (for non-interactive / agent use)
FORCE=false
if [[ "${1:-}" == "--force" || "${EDEN_GRAFT_FORCE:-}" == "true" ]]; then
    FORCE=true
fi

# Check if jq is installed
if ! command -v jq >/dev/null 2>&1; then
    echo "  ⚠ jq required for MCP graft (skipping)"
    exit 0
fi

# Detect Eden root from script location
if [[ -z "$EDEN_ROOT" ]]; then
    SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
    EDEN_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/../../../../.." && pwd)"
fi

# shellcheck source=lib/branches.sh
source "$EDEN_ROOT/lib/branches.sh"
# shellcheck source=lib/collisions.sh
source "$EDEN_ROOT/lib/collisions.sh"

CANONICAL_CONFIG="$HOME/.config/mcp/servers.json"

BRANCHES_FILE="$(eden_branches_file)"

# branch_mcp_config <branch path>: the branch's global MCP file, if any.
branch_mcp_config() {
    local file
    for file in "$1/.config/mcp/servers.json" \
        "$1/.cursor/mcp.json" \
        "$1/packages/common/.config/cursor/mcp_config.branch.json"; do
        # The canonical path mirrors $HOME; the other two are legacy fallbacks.
        if [[ -f "$file" ]]; then
            printf '%s\n' "$file"
            return 0
        fi
    done
    return 1
}

# for_each_project <function>: call it with (branch name, project name,
# servers file, target directory) for every project MCP scope.
for_each_project() {
    local branch_path projects_dir target_file project_dir local_name project_mcp project_target
    [[ -f "$BRANCHES_FILE" ]] || return 0
    while IFS= read -r branch_path; do
        projects_dir="$branch_path/projects"
        [[ -d "$projects_dir" ]] || continue

        while IFS= read -r target_file || [[ -n "$target_file" ]]; do
            project_dir=$(dirname "$target_file")
            local_name="${project_dir#"$projects_dir"/}"
            project_mcp="$project_dir/.mcp/servers.json"
            [[ -f "$project_mcp" ]] || continue

            project_target=$(eden_branch_expand "$(head -1 "$target_file" | tr -d '[:space:]')")
            "$1" "$(basename "$branch_path")" "$local_name" "$project_mcp" "$project_target"
        done < <(find "$projects_dir" -name .eden-target -type f || true)
    done < <(eden_branches)
}

# Every server name is a named entry: two branches naming the same server,
# globally or for the same project, collide.
# shellcheck disable=SC2329  # called through for_each_project
claim_project() {
    local name
    [[ -d "$4" ]] || return 0
    while IFS= read -r name; do
        printf '%s: MCP server %s\t%s\n' "$(eden_home_path "$4")" "$name" "$1:$2"
    done < <(jq -r '.mcpServers // {} | keys[]' "$3")
}

claims() {
    local branch_path config name
    if [[ -f "$BRANCHES_FILE" ]]; then
        while IFS= read -r branch_path; do
            config="$(branch_mcp_config "$branch_path")" || continue
            while IFS= read -r name; do
                printf 'MCP server %s\t%s\n' "$name" "$(basename "$branch_path")"
            done < <(jq -r '.mcpServers // {} | keys[]' "$config")
        done < <(eden_branches)
    fi
    for_each_project claim_project
}

claims | eden_check_collisions || exit 1

# Initialize with empty config
MERGED_JSON='{"mcpServers": {}}'

echo "  → Merging MCP servers from branches"

if [[ -f "$BRANCHES_FILE" ]]; then
    while IFS= read -r branch_path; do
        branch_config="$(branch_mcp_config "$branch_path")" || continue
        echo "  → Merging MCP servers from: $(basename "$branch_path")"
        MERGED_JSON=$(echo "$MERGED_JSON" | jq --slurpfile branch "$branch_config" \
            '.mcpServers += $branch[0].mcpServers')
    done < <(eden_branches)
fi

# Ensure canonical directory exists
mkdir -p "$(dirname "$CANONICAL_CONFIG")"

# Resolve bare command names to absolute paths.
# GUI clients (Claude Desktop, Cursor) don't inherit shell PATH, so bare
# commands like "mcp-foo" or "npx" won't be found. The graft runs from a
# terminal with the full PATH, so we resolve here at plant time.
resolve_commands() {
    local json="$1" server cmd full_path
    while IFS= read -r server; do
        cmd=$(printf '%s' "$json" | jq -r --arg s "$server" '.mcpServers[$s].command // empty')
        [[ -z "$cmd" || "$cmd" == /* ]] && continue
        full_path=$(command -v "$cmd" 2>/dev/null) || {
            echo "  ⚠ Cannot resolve command '$cmd' for server '$server'" >&2
            continue
        }
        json=$(printf '%s' "$json" | jq --arg s "$server" --arg p "$full_path" \
            '.mcpServers[$s].command = $p')
    done < <(printf '%s' "$json" | jq -r '.mcpServers | keys[]')
    printf '%s' "$json"
}

# Resolve commands and write to canonical location
MERGED_JSON=$(resolve_commands "$MERGED_JSON")
echo "$MERGED_JSON" | jq '.' > "$CANONICAL_CONFIG"

# Sync MCP servers into a client's config.
# Merges only .mcpServers — preserves other keys (app preferences, etc.).
sync_mcp_client() {
    local client_name="$1" client_config="$2"
    local client_dir
    client_dir="$(dirname "$client_config")"
    [[ -d "$client_dir" ]] || return 0

    # Resolve bare commands to absolute paths for GUI clients
    local resolved_json
    resolved_json=$(resolve_commands "$(cat "$CANONICAL_CONFIG")")

    # No config yet — just write resolved config
    if [[ ! -f "$client_config" ]]; then
        printf '%s' "$resolved_json" | jq '.' > "$client_config"
        echo "  → Synced $client_name"
        return 0
    fi

    # Merge Eden's mcpServers into the client config, preserving other keys
    local merged
    merged=$(jq -S --argjson eden "$resolved_json" \
        '.mcpServers = $eden.mcpServers' "$client_config")

    # Already in sync — nothing to do
    if diff -q <(echo "$merged") <(jq -S . "$client_config") &>/dev/null; then
        echo "  → $client_name in sync"
        return 0
    fi

    # Differs — force-apply or prompt
    echo "  ⚠ $client_name MCP servers differ from Eden"
    if [[ "$FORCE" == "true" ]]; then
        echo "$merged" | jq . > "$client_config"
        echo "  → Applied Eden MCP servers to $client_name"
        return 0
    fi
    if [[ -t 0 ]]; then
        while true; do
            echo -n "    [a]pply, [s]kip, [d]iff? "
            read -r choice
            case "$choice" in
                a|A)
                    echo "$merged" | jq . > "$client_config"
                    echo "  → Applied Eden MCP servers to $client_name"
                    break ;;
                s|S)
                    echo "  → Skipped $client_name"
                    break ;;
                d|D)
                    diff -u --label "current ($client_name)" --label "after (eden merged)" \
                        <(jq -S . "$client_config") <(echo "$merged") \
                        | if command -v delta &>/dev/null; then delta
                          elif command -v colordiff &>/dev/null; then colordiff
                          else cat; fi || true
                    ;;
                *) echo "    Please enter a, s, or d" ;;
            esac
        done
    else
        echo "    Skipped (run interactively to resolve)"
    fi
}

# Sync MCP servers into Claude Code's ~/.claude.json.
# Union merge: preserves user-added global servers, Eden servers win on conflicts.
sync_claude_code() {
    local client_config="$HOME/.claude.json"
    [[ -f "$client_config" ]] || return 0

    local merged
    merged=$(jq -S --slurpfile eden "$CANONICAL_CONFIG" \
        '.mcpServers = ((.mcpServers // {}) + $eden[0].mcpServers)' "$client_config")

    if diff -q <(echo "$merged") <(jq -S . "$client_config") &>/dev/null; then
        echo "  → Claude Code in sync"
        return 0
    fi

    echo "$merged" | jq . > "$client_config"
    echo "  → Synced Claude Code"
}

# Sync to MCP clients
sync_mcp_client "Cursor" "$HOME/.cursor/mcp.json"
# Claude Desktop: MCP servers managed via Settings → Connectors (not config file)
sync_claude_code

# =============================================================================
# Project scope: place .mcp.json in target directories
# =============================================================================

# Write project MCP config to a target directory's client-specific files.
# Resolves bare commands and writes .mcp.json (Claude Code) + .cursor/mcp.json.
# shellcheck disable=SC2329  # called by graft_project, through for_each_project
sync_project_mcp() {
    local project_servers="$1" target_dir="$2" project_name="$3"

    # Resolve bare commands for all clients
    local resolved
    resolved=$(resolve_commands "$project_servers")

    # Union merge into existing target file (eden wins on name conflicts).
    # Preserves project-tracked servers; never clobbers user-managed entries.
    _merge_into() {
        local target_file="$1"
        if [[ -f "$target_file" ]]; then
            local merged
            merged=$(jq -S --argjson eden "$resolved" \
                '.mcpServers = ((.mcpServers // {}) + $eden.mcpServers)' "$target_file")
            if diff -q <(echo "$merged") <(jq -S . "$target_file") &>/dev/null; then
                return 0
            fi
            echo "$merged" | jq '.' > "$target_file"
        else
            printf '%s' "$resolved" | jq '.' > "$target_file"
        fi
    }

    _merge_into "$target_dir/.mcp.json"

    # Cursor: .cursor/mcp.json (only if .cursor/ exists)
    if [[ -d "$target_dir/.cursor" ]]; then
        _merge_into "$target_dir/.cursor/mcp.json"
    fi

    local count
    count=$(printf '%s' "$project_servers" | jq '.mcpServers | length')
    echo "  → projects/$project_name: $count server(s)"
}

project_count=0
# shellcheck disable=SC2329  # called through for_each_project
graft_project() {
    if [[ ! -d "$4" ]]; then
        echo "  ⚠ projects/$2: target $4 not found (skipping MCP)"
        return 0
    fi
    sync_project_mcp "$(cat "$3")" "$4" "$2"
    project_count=$((project_count + 1))
}
for_each_project graft_project

# Show summary
SERVER_COUNT=$(echo "$MERGED_JSON" | jq '.mcpServers | length')
echo "  → Configured $SERVER_COUNT global MCP server(s)"
[[ $project_count -gt 0 ]] && echo "  → Configured $project_count project MCP scope(s)"

exit 0

