#!/bin/bash
# graft-mcp - Merge MCP servers from trunk and branches
#
# Two scopes:
#   1. Global: branch/.config/mcp/servers.json → merged into ~/.config/mcp/servers.json,
#      a garden's branch only while its garden is in view
#   2. Project: branch/projects/<path>/.mcp/servers.json → Claude Code's local scope
#      for the repo at <target> (its subdirectories and linked worktrees too),
#      where <target> is read from projects/<path>/.eden-target
#
# Part of Eden's pluggable grafter system
set -e
trap 'echo "  !! graft-mcp failed at line $LINENO" >&2' ERR

if [[ "${1:-}" == "--api-version" ]]; then
    echo 1
    exit 0
fi

# Report covered paths for eden doctor
if [[ "${1:-}" == "--covers" ]]; then
    echo ".config/mcp"
    echo "projects"   # project scope: projects/<path>/ with an .eden-target
    exit 0
fi

# Check if jq is installed
if ! command -v jq >/dev/null 2>&1; then
    echo "  ⚠ jq required for MCP graft (skipping)"
    exit 0
fi

# Detect Eden root from script location
if [[ -z "$EDEN_ROOT" ]]; then
    SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
    EDEN_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/../../../../.." && pwd)"
fi

# shellcheck source=lib/branches.sh
source "$EDEN_ROOT/lib/branches.sh"
# shellcheck source=lib/collisions.sh
source "$EDEN_ROOT/lib/collisions.sh"

CANONICAL_CONFIG="$HOME/.config/mcp/servers.json"
# Claude Code's state file, which holds its user-scope servers and each
# project's local-scope ones: under CLAUDE_CONFIG_DIR when that is set,
# as Claude Code reads it. EDEN_CLAUDE_CLI names another claude command.
CLAUDE_STATE="${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json"
CLAUDE_CLI="${EDEN_CLAUDE_CLI:-claude}"

# What graft-mcp put in Claude Code, so a later graft can take out what no
# branch declares any more and leave alone servers added by hand under a
# name no branch uses (one that shares a branch's name is Eden's from then
# on): per state file, the user-scope names and each repo's local-scope
# names.
MCP_RECORD="${XDG_STATE_HOME:-$HOME/.local/state}/eden/mcp-servers.json"
RECORD_OLD="$(jq -c --arg s "$CLAUDE_STATE" '.[$s] // {}' "$MCP_RECORD" 2>/dev/null)" || RECORD_OLD=""
if [[ -z "$RECORD_OLD" && -f "$MCP_RECORD" ]]; then
    echo "  ⚠ $(eden_home_path "$MCP_RECORD") was unreadable: starting a new record, so servers an earlier graft added stay until removed by hand"
fi
[[ -n "$RECORD_OLD" ]] || RECORD_OLD='{}'
USER_SYNCED=false
# Without the CLI nothing goes into or out of local scope, whether or not
# a project reaches sync_local_scope.
LOCAL_SKIPPED=false
command -v "$CLAUDE_CLI" >/dev/null 2>&1 || LOCAL_SKIPPED=true
LOCAL_WANTED='{}'

# branch_mcp_config <branch path>: the branch's global MCP file, if any.
branch_mcp_config() {
    local file
    [[ -f "$1/.config/mcp/servers.json" ]] || return 1
    printf '%s\n' "$1/.config/mcp/servers.json"
}

# for_each_project <function>: call it with (branch name, project name,
# servers file, target directory) for every project MCP scope.
for_each_project() {
    local branch_path projects_dir target_file project_dir local_name project_mcp project_target
    eden_branch_list_exists || return 0
    while IFS= read -r branch_path; do
        projects_dir="$branch_path/projects"
        [[ -d "$projects_dir" ]] || continue

        while IFS= read -r target_file || [[ -n "$target_file" ]]; do
            project_dir=$(dirname "$target_file")
            local_name="${project_dir#"$projects_dir"/}"
            project_mcp="$project_dir/.mcp/servers.json"
            [[ -f "$project_mcp" ]] || continue

            project_target=$(eden_project_target "$target_file") || true
            "$1" "$(eden_branch_name "$branch_path")" "$local_name" "$project_mcp" "$project_target"
        done < <(find "$projects_dir" -name .eden-target -type f || true)
    done < <(eden_graft_roots)
}

# Every server name is a named entry: two branches naming the same server,
# globally or for the same project, collide. Two gardens' global servers
# are never in user scope together, so they collide only with the shared
# branches' and their own garden's.
# shellcheck disable=SC2329  # called through for_each_project
claim_project() {
    local name
    [[ -d "$4" ]] || return 0
    while IFS= read -r name; do
        printf '%s: MCP server %s\t%s\n' "$(eden_home_path "$4")" "$name" "$1:$2"
    done < <(jq -r '.mcpServers // {} | keys[]' "$3")
}

claims() {
    local branch_path config name
    if eden_branch_list_exists; then
        while IFS= read -r branch_path; do
            eden_in_view "$branch_path" || continue
            config="$(branch_mcp_config "$branch_path")" || continue
            while IFS= read -r name; do
                printf 'MCP server %s\t%s\n' "$name" "$(eden_branch_name "$branch_path")"
            done < <(jq -r '.mcpServers // {} | keys[]' "$config")
        done < <(eden_graft_roots)
    fi
    for_each_project claim_project
}

claims | eden_check_collisions || exit 1

# Initialize with empty config
MERGED_JSON='{"mcpServers": {}}'

echo "  → Merging MCP servers from branches"

if eden_branch_list_exists; then
    while IFS= read -r branch_path; do
        branch_config="$(branch_mcp_config "$branch_path")" || continue
        if ! eden_in_view "$branch_path"; then
            echo "  → $(eden_branch_name "$branch_path"): global servers wait for $(eden_garden_of "$branch_path") to be in view"
            continue
        fi
        echo "  → Merging MCP servers from: $(eden_branch_name "$branch_path")"
        MERGED_JSON=$(echo "$MERGED_JSON" | jq --slurpfile branch "$branch_config" \
            '.mcpServers += $branch[0].mcpServers')
    done < <(eden_graft_roots)
fi

# Ensure canonical directory exists
mkdir -p "$(dirname "$CANONICAL_CONFIG")"

# Resolve bare command names to absolute paths.
# GUI clients don't inherit shell PATH, so bare
# commands like "mcp-foo" or "npx" won't be found. The graft runs from a
# terminal with the full PATH, so we resolve here at plant time.
resolve_commands() {
    local json="$1" server cmd full_path
    while IFS= read -r server; do
        cmd=$(printf '%s' "$json" | jq -r --arg s "$server" '.mcpServers[$s].command // empty')
        [[ -z "$cmd" || "$cmd" == /* ]] && continue
        full_path=$(command -v "$cmd" 2>/dev/null) || {
            echo "  ⚠ Cannot resolve command '$cmd' for server '$server'" >&2
            continue
        }
        json=$(printf '%s' "$json" | jq --arg s "$server" --arg p "$full_path" \
            '.mcpServers[$s].command = $p')
    done < <(printf '%s' "$json" | jq -r '.mcpServers | keys[]')
    printf '%s' "$json"
}

# Resolve commands and write to canonical location
MERGED_JSON=$(resolve_commands "$MERGED_JSON")
echo "$MERGED_JSON" | jq '.' > "$CANONICAL_CONFIG"

# Sync MCP servers into Claude Code's state file (user scope). Servers
# added by hand stay; Eden's win on a name both use; the ones an earlier
# graft added that no branch declares any more are taken out.
sync_claude_code() {
    local client_config="$CLAUDE_STATE"
    [[ -f "$client_config" ]] || return 0
    USER_SYNCED=true

    local drop gone merged name
    drop=$(jq -c --argjson old "$RECORD_OLD" \
        '[($old.user // [])[] as $n | select(.mcpServers[$n] == null) | $n]' "$CANONICAL_CONFIG")
    gone=$(jq -r --argjson drop "$drop" '$drop[] as $n | select(.mcpServers[$n] != null) | $n' "$client_config")
    merged=$(jq -S --slurpfile eden "$CANONICAL_CONFIG" --argjson drop "$drop" \
        '.mcpServers = (((.mcpServers // {}) | with_entries(select(.key as $k | $drop | index($k) | not))) + $eden[0].mcpServers)' "$client_config")

    if diff -q <(echo "$merged") <(jq -S . "$client_config") &>/dev/null; then
        echo "  → Claude Code in sync"
        return 0
    fi

    echo "$merged" | jq . > "$client_config"
    while IFS= read -r name; do
        [[ -n "$name" ]] && echo "    − $name (user scope: no branch declares it now)"
    done <<< "$gone"
    echo "  → Synced Claude Code"
}

# Claude Desktop: MCP servers managed via Settings → Connectors (not config file)
sync_claude_code

# =============================================================================
# Project scope: place .mcp.json in target directories
# =============================================================================

# Claude Code keeps a project's local-scope servers in its own state file,
# under the repo's path: they reach the repo's subdirectories and linked
# worktrees, and leave no untracked file in the repo. Written through the
# CLI, which owns that file; read directly, to leave alone what is already
# right.
# sync_local_scope <resolved servers json> <target dir>
# shellcheck disable=SC2329  # called by sync_project_mcp, through for_each_project
sync_local_scope() {
    local resolved="$1" target_dir="$2" key name want have stale=""

    if ! command -v "$CLAUDE_CLI" >/dev/null 2>&1; then
        echo "  ⚠ $CLAUDE_CLI not found: skipping Claude Code's servers for $(eden_home_path "$target_dir")"
        LOCAL_SKIPPED=true
        return 0
    fi

    key="$(cd "$target_dir" && { git rev-parse --show-toplevel 2>/dev/null || pwd -P; })"
    LOCAL_WANTED=$(jq -c --arg k "$key" --argjson n "$(printf '%s' "$resolved" | jq -c '.mcpServers | keys')" \
        '.[$k] = (((.[$k] // []) + $n) | unique)' <<< "$LOCAL_WANTED")
    while IFS= read -r name; do
        want="$(printf '%s' "$resolved" | jq -cS --arg n "$name" '.mcpServers[$n]')"
        have=""
        if [[ -f "$CLAUDE_STATE" ]]; then
            have="$(jq -cS --arg k "$key" --arg n "$name" '.projects[$k].mcpServers[$n] // empty' "$CLAUDE_STATE")"
        fi
        [[ "$have" == "$want" ]] && continue

        # An entry under another spelling of the path is found by the add
        # failing; replacing it is the same as replacing a changed one.
        if [[ -n "$have" ]] || ! (cd "$target_dir" && "$CLAUDE_CLI" mcp add-json -s local "$name" "$want" >/dev/null 2>&1); then
            (cd "$target_dir" && "$CLAUDE_CLI" mcp remove -s local "$name" >/dev/null 2>&1) || true
            if ! (cd "$target_dir" && "$CLAUDE_CLI" mcp add-json -s local "$name" "$want" >/dev/null); then
                echo "  ✗ $name: $CLAUDE_CLI could not add it to $(eden_home_path "$target_dir")" >&2
                return 1
            fi
        fi
        echo "    → $name (Claude Code, local scope)"
    done < <(printf '%s' "$resolved" | jq -r '.mcpServers | keys[]')

    # Earlier grafts wrote the servers into an untracked .mcp.json; the
    # local scope has them now, so a copy there only goes stale.
    if [[ -f "$target_dir/.mcp.json" ]] && ! git -C "$target_dir" ls-files --error-unmatch .mcp.json >/dev/null 2>&1; then
        stale="$(jq -r --argjson eden "$resolved" \
            '[(.mcpServers // {} | keys[]) as $n | select($eden.mcpServers[$n] != null) | $n] | join(", ")' \
            "$target_dir/.mcp.json" 2>/dev/null)" || stale=""
        if [[ -n "$stale" ]]; then
            echo "  ⚠ $(eden_home_path "$target_dir")/.mcp.json is untracked and still has $stale from an earlier graft; Claude Code has them in local scope now, so remove them from the file"
        fi
    fi
}

# Write a project's servers to Claude Code's local scope, bare commands
# resolved first.
# shellcheck disable=SC2329  # called by graft_project, through for_each_project
sync_project_mcp() {
    local project_servers="$1" target_dir="$2" project_name="$3"

    local count
    count=$(printf '%s' "$project_servers" | jq '.mcpServers | length')
    echo "  → projects/$project_name: $count server(s)"

    # Resolve bare commands for all clients
    local resolved
    resolved=$(resolve_commands "$project_servers")

    sync_local_scope "$resolved" "$target_dir"
}

project_count=0
project_failed=0
# shellcheck disable=SC2329  # called through for_each_project
graft_project() {
    if [[ ! -d "$4" ]]; then
        echo "  ⚠ projects/$2: target $4 not found (skipping MCP)"
        return 0
    fi
    sync_project_mcp "$(cat "$3")" "$4" "$2" || project_failed=1
    project_count=$((project_count + 1))
}
for_each_project graft_project

# The servers an earlier graft put in a repo's local scope that no branch
# declares there now — the project left its branch, or its garden is no
# longer grown here — are taken out. A repo not on this machine keeps its
# record until it is back. Without the CLI nothing was added or removed,
# so the record stays as it was.
LOCAL_RECORD="$LOCAL_WANTED"
prune_local_scope() {
    local key names name
    if $LOCAL_SKIPPED; then
        LOCAL_RECORD=$(jq -c '.local // {}' <<< "$RECORD_OLD")
        return 0
    fi
    while IFS= read -r key; do
        names=$(jq -r --arg k "$key" --argjson want "$LOCAL_WANTED" \
            '(.local[$k] // []) - ($want[$k] // []) | .[]' <<< "$RECORD_OLD")
        [[ -n "$names" ]] || continue
        if [[ ! -d "$key" ]]; then
            LOCAL_RECORD=$(jq -c --arg k "$key" --argjson old "$RECORD_OLD" \
                '.[$k] = (((.[$k] // []) + ($old.local[$k] // [])) | unique)' <<< "$LOCAL_RECORD")
            continue
        fi
        while IFS= read -r name; do
            if (cd "$key" && "$CLAUDE_CLI" mcp remove -s local "$name" >/dev/null 2>&1); then
                echo "    − $name ($(eden_home_path "$key"), local scope: no branch declares it now)"
            fi
        done <<< "$names"
    done < <(jq -r '.local // {} | keys[]' <<< "$RECORD_OLD")
}
prune_local_scope

write_record() {
    local all="" user
    if $USER_SYNCED; then
        user=$(jq -c '.mcpServers | keys' "$CANONICAL_CONFIG")
    else
        user=$(jq -c '.user // []' <<< "$RECORD_OLD")
    fi
    if [[ -f "$MCP_RECORD" ]]; then
        all=$(jq -c . "$MCP_RECORD" 2>/dev/null) || all=""
    fi
    [[ -n "$all" ]] || all='{}'
    mkdir -p "$(dirname "$MCP_RECORD")"
    jq --arg s "$CLAUDE_STATE" --argjson user "$user" --argjson local "$LOCAL_RECORD" \
        '.[$s] = {user: $user, local: $local}' <<< "$all" > "$MCP_RECORD.tmp"
    mv "$MCP_RECORD.tmp" "$MCP_RECORD"
}
write_record

# Show summary
SERVER_COUNT=$(echo "$MERGED_JSON" | jq '.mcpServers | length')
echo "  → Configured $SERVER_COUNT global MCP server(s)"
[[ $project_count -gt 0 ]] && echo "  → Configured $project_count project MCP scope(s)"

[[ $project_failed -eq 0 ]] || exit 1

exit 0

