#!/usr/bin/env bash
# graft-configs - Symlink config files from branches using stow
# This handles standard dotfiles and configs that don't need special merging logic

set -euo pipefail
trap 'echo "  !! graft-configs failed at line $LINENO" >&2' ERR

if [[ "${1:-}" == "--api-version" ]]; then
    echo 1
    exit 0
fi

# graft-configs uses .eden-graft allowlists — no fixed --covers patterns
if [[ "${1:-}" == "--covers" ]]; then
    exit 0
fi

# Detect Eden root from script location
if [[ -z "${EDEN_ROOT:-}" ]]; then
    SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
    EDEN_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/../../../../.." && pwd)"
fi

# shellcheck source=lib/branches.sh
source "$EDEN_ROOT/lib/branches.sh"

BRANCHES_FILE="$(eden_branches_file)"

# Exit if no branches configured
if [ ! -f "$BRANCHES_FILE" ]; then
    echo "  → No branches registered (skipping)"
    exit 0
fi

# shellcheck source=lib/collisions.sh
source "$EDEN_ROOT/lib/collisions.sh"

echo "  → Symlinking configs from branches"

GRAFTED_COUNT=0

# graft_all claims|link: walk every branch's allowlist. With "claims" it
# only lists each target and its branch; with "link" it links.
graft_all() {
    local mode="$1" branch_path branch_name config_path source_path target_path

    while IFS= read -r branch_path; do
        branch_name=$(eden_branch_name "$branch_path")
        [[ -d "$branch_path" && -f "$branch_path/.eden-graft" ]] || continue

        if [[ "$mode" == link ]]; then
            echo "  → Grafting configs from: $branch_name"
        fi

        while IFS= read -r config_path || [[ -n "$config_path" ]]; do
            [[ -z "$config_path" ]] && continue
            [[ "$config_path" =~ ^[[:space:]]*# ]] && continue
            config_path=$(echo "$config_path" | xargs)

            source_path="$branch_path/$config_path"
            target_path="$HOME/$config_path"

            # Skip if source doesn't exist
            if [[ ! -e "$source_path" ]]; then
                if [[ "$mode" == link ]]; then
                    echo "    ⚠ Not found: $config_path (skipping)"
                fi
                continue
            fi

            if [[ "$mode" == claims ]]; then
                printf '%s\t%s\n' "$(eden_home_path "$target_path")" "$branch_name"
                continue
            fi

            mkdir -p "$(dirname "$target_path")"

            # Symlink the whole entry (dir or file) at $target_path → $source_path.
            # Stow is the wrong tool here: with `stow PKG`, the package name is
            # stripped and the package's *contents* land in the target, not the
            # package itself. We want the dir name preserved (e.g. ~/.config/nvim
            # → branch/.config/nvim), so plain ln -sfn does the right thing and
            # is idempotent across re-grafts.
            if [[ -d "$source_path" && ! -L "$target_path" && -d "$target_path" ]]; then
                # Real directory already lives at the target (e.g. an app's
                # local data dir). Don't clobber — ask the user to graft the
                # specific files inside it via .eden-graft instead.
                echo "    ⚠ Skipped: $config_path ($target_path is a real directory; list its files individually in .eden-graft)"
                continue
            fi

            if [[ -e "$target_path" && ! -L "$target_path" ]]; then
                echo "    ⚠ Skipped: $config_path ($target_path exists and is not a symlink)"
                continue
            fi

            ln -sfn "$source_path" "$target_path"
            echo "    → Linked: $config_path"
        done < "$branch_path/.eden-graft"

        if [[ "$mode" == link ]]; then
            GRAFTED_COUNT=$((GRAFTED_COUNT + 1))
        fi
    done < <(eden_graft_roots)
}

graft_all claims | eden_check_collisions || exit 1
graft_all link

# Create HOME symlinks for tools that don't support XDG
if [[ "$(uname -s)" == "Darwin" ]]; then
    if [[ -f "$HOME/.config/skhd/skhdrc" ]] && [[ ! -e "$HOME/.skhdrc" ]]; then
        ln -sf "$HOME/.config/skhd/skhdrc" "$HOME/.skhdrc"
        echo "  → Linked: ~/.skhdrc → .config/skhd/skhdrc (skhd has no XDG support)"
    fi
fi

if [ "$GRAFTED_COUNT" -gt 0 ]; then
    echo "  → Grafted configs from $GRAFTED_COUNT branch(es)"
else
    echo "  → No branch configs found"
fi

