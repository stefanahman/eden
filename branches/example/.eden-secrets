# Eden Secrets Registry (example branch)
#
# Declare secrets your branch's tooling needs. Eden doesn't store them — your
# secret store does. `eden-secrets validate` checks that each path can be fetched.
#
# Default fetch command is `op read` (1Password). Override via EDEN_SECRET_GET
# (e.g. EDEN_SECRET_GET="pass show") to use a different provider. The path
# format follows your provider's conventions.
#
# Each [secret] stanza supports:
#   id              — short identifier (used by `eden-secrets lookup <id>`)
#   name            — human-readable label
#   path            — provider-specific path to the secret
#   description     — what this secret is for
#   required_by     — which tool/feature needs it
#   op_account      — 1Password account domain (1Password-only)
#   setup_command   — optional command/url to create the secret

# Example stanza (commented out — uncomment and replace to use):
# [secret]
# id=example-token
# name=Example API Token
# path=op://Vault/Item/credential
# description=API token for the example service
# required_by=example-service-cli
# op_account=my.1password.com
# setup_command=echo "Create at https://example.com/tokens"
