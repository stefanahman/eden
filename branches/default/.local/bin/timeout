#!/usr/bin/env perl
# timeout: stock-macOS alternative to GNU coreutils `timeout`.
# usage: timeout SECONDS COMMAND [ARGS...]
# Sends SIGTERM after SECONDS. Exits 124 on timeout (matches GNU).

use strict;
use warnings;

@ARGV >= 2 && $ARGV[0] =~ /^\d+$/
    or die "usage: timeout SECONDS COMMAND [ARGS...]\n";

my $secs = shift @ARGV;
my $pid  = fork // die "timeout: fork: $!\n";

if ($pid == 0) {
    exec { $ARGV[0] } @ARGV or die "timeout: exec $ARGV[0]: $!\n";
}

local $SIG{ALRM} = sub { kill TERM => $pid; exit 124 };
alarm $secs;
waitpid $pid, 0;
my $status = $?;
alarm 0;

exit(($status & 0x7f) ? 128 + ($status & 0x7f) : $status >> 8);
