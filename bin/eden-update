#!/bin/bash
# Eden updater — Update Eden according to the configured track and re-deploy packages.
#
# Track modes (stored in ~/.config/eden/track):
#   latest    Follow release tags — checkout the newest vX.Y.Z (default)
#   main      Follow main branch — git pull (maintainer/dev mode)
#   vX.Y.Z    Pinned to a specific release — stay put until explicitly switched
#
# Usage:
#   eden update            Update according to saved track
#   eden update --check    Show current vs available without applying
#   eden update --latest   Switch to following the latest release
#   eden update --main     Switch to following main
#   eden update vX.Y.Z     Switch to a specific release tag
set -e

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

log()  { echo -e "${BLUE}→${NC} $1"; }
ok()   { echo -e "${GREEN}✓${NC} $1"; }
warn() { echo -e "${YELLOW}⚠${NC} $1"; }
err()  { echo -e "${RED}✗${NC} $1" >&2; exit 1; }

EDEN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
EDEN_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/eden"
TRACK_FILE="$EDEN_CONFIG/track"

cd "$EDEN_DIR" || err "Failed to cd to Eden directory"

# Parse args
CHECK_ONLY=false
SWITCH_TO=""
for arg in "$@"; do
    case "$arg" in
        --check) CHECK_ONLY=true ;;
        --latest) SWITCH_TO="latest" ;;
        --main) SWITCH_TO="main" ;;
        v[0-9]*) SWITCH_TO="$arg" ;;
        -h|--help)
            sed -n '2,14p' "${BASH_SOURCE[0]}" | sed 's/^# \?//'
            exit 0
            ;;
        *) err "Unknown arg: $arg" ;;
    esac
done

# Determine current track
if [ -n "$SWITCH_TO" ]; then
    TRACK="$SWITCH_TO"
elif [ -f "$TRACK_FILE" ]; then
    TRACK="$(tr -d '[:space:]' < "$TRACK_FILE")"
else
    TRACK="latest"
fi

# What ref are we currently on?
CURRENT_REF=$(git describe --tags --exact-match HEAD 2>/dev/null \
              || git rev-parse --abbrev-ref HEAD 2>/dev/null \
              || echo "unknown")

# What ref does the track resolve to?
resolve_target() {
    case "$TRACK" in
        main)
            echo "main"
            ;;
        latest)
            git fetch --tags --quiet 2>/dev/null || true
            local latest
            latest=$(git tag -l 'v*' --sort=-version:refname 2>/dev/null | head -n 1)
            if [ -z "$latest" ]; then
                echo "main"
            else
                echo "$latest"
            fi
            ;;
        v*)
            git fetch --tags --quiet 2>/dev/null || true
            echo "$TRACK"
            ;;
        *)
            err "Unknown track: $TRACK"
            ;;
    esac
}

TARGET=$(resolve_target)

# --check mode: report only
if $CHECK_ONLY; then
    echo "Track:    $TRACK"
    echo "Current:  $CURRENT_REF"
    echo "Target:   $TARGET"
    if [ "$CURRENT_REF" = "$TARGET" ]; then
        ok "Up to date"
    else
        warn "Update available: $CURRENT_REF → $TARGET"
    fi
    exit 0
fi

# Refuse on a dirty tree
if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
    err "Uncommitted changes detected — commit or stash before updating."
fi

# Apply the update
case "$TRACK" in
    main)
        log "Pulling latest changes on main…"
        git checkout --quiet main 2>/dev/null || true
        git pull --ff-only || err "git pull failed"
        ;;
    latest|v*)
        if [ "$CURRENT_REF" = "$TARGET" ]; then
            ok "Already on $TARGET"
        else
            log "Switching to $TARGET"
            git checkout --quiet "$TARGET" || err "Failed to checkout $TARGET"
        fi
        ;;
esac

# Persist track change if --latest/--main/vX.Y.Z was passed
if [ -n "$SWITCH_TO" ]; then
    echo "$TRACK" > "$TRACK_FILE"
    ok "Saved track: $TRACK"
fi

# Re-deploy packages
OS=""
case "$(uname -s)" in
    Linux*) OS="arch" ;;
    Darwin*) OS="mac" ;;
    *) err "Unsupported OS" ;;
esac

log "Re-deploying packages…"
stow -R -t "$HOME" -d packages common "$OS" || err "Failed to re-stow packages"

ok "Eden updated successfully"
