#!/bin/bash
# Eden doctor - Health check and validation
#
# Usage: eden doctor [--format=pretty|plain]
#
# Exit codes:
#   0  All checks passed
#   1  Warnings only
#   2  Errors found
set -e

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

ERRORS=0
WARNINGS=0
FORMAT="pretty"

for arg in "$@"; do
    case "$arg" in
        --format=plain)  FORMAT="plain" ;;
        --format=pretty) FORMAT="pretty" ;;
        -h|--help)
            sed -n '2,9p' "${BASH_SOURCE[0]}" | sed -E 's/^# ?//'
            exit 0
            ;;
        *)
            echo "Unknown option: $arg" >&2
            echo "See: eden doctor --help" >&2
            exit 2
            ;;
    esac
done

check_pass() {
    if [[ "$FORMAT" == "plain" ]]; then
        echo "ok|$1"
    else
        echo -e "  ${GREEN}✓${NC} $1"
    fi
}

check_fail() {
    if [[ "$FORMAT" == "plain" ]]; then
        echo "error|$1"
    else
        echo -e "  ${RED}✗${NC} $1"
    fi
    # ((var++)) returns the OLD value (0 on first call), which trips set -e.
    # Use arithmetic assignment which always exits 0.
    ERRORS=$((ERRORS + 1))
}

check_warn() {
    if [[ "$FORMAT" == "plain" ]]; then
        echo "warn|$1"
    else
        echo -e "  ${YELLOW}⚠${NC} $1"
    fi
    WARNINGS=$((WARNINGS + 1))
}

section() {
    # Skip section headers in plain mode (machine-parseable output)
    [[ "$FORMAT" == "plain" ]] && return
    echo ""
    echo "$1"
}

# Informational sub-output that doesn't fit ok/warn/error severity (e.g.,
# package counts, orphan lists nested under a warn). In plain mode it
# becomes 'info|message'; in pretty mode, just an indented line.
info_line() {
    if [[ "$FORMAT" == "plain" ]]; then
        echo "info|$1"
    else
        echo "  $1"
    fi
}

# Get Eden directory (parent of bin/)
EDEN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
EDEN_ROOT="${EDEN_ROOT:-$EDEN_DIR}"
# shellcheck source=lib/branches.sh
source "$EDEN_ROOT/lib/branches.sh"

section "Eden Health Check"
section "=================="

# Check dependencies
section "Dependencies:"

if command -v git >/dev/null 2>&1; then
    GIT_VER=$(git --version | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    check_pass "git installed ($GIT_VER)"
else
    check_fail "git not found"
fi

# Tools a mise config declares (a branch's, linked by graft-configs) are
# installed by graft-mise; one still missing is named here.
MISE="${EDEN_MISE:-mise}"
if command -v "$MISE" >/dev/null 2>&1; then
    MISE_MISSING="$(cd "$HOME" && "$MISE" ls --missing 2>/dev/null)" || MISE_MISSING=""
    MISE_MISSING="$(printf '%s\n' "$MISE_MISSING" | awk 'NF { print $1 "@" $2 }' | paste -sd' ' -)"
    if [[ -n "$MISE_MISSING" ]]; then
        check_warn "mise tools declared but not installed: $MISE_MISSING (run eden graft)"
    else
        check_pass "mise tools installed"
    fi
fi

if command -v stow >/dev/null 2>&1; then
    STOW_VER=$(stow --version | head -1 | grep -oE '[0-9]+\.[0-9]+' | head -1)
    if awk -v ver="$STOW_VER" 'BEGIN { exit (ver < 2.3) }'; then
        check_pass "stow installed ($STOW_VER)"
    else
        check_warn "stow $STOW_VER (recommend >= 2.3.0)"
    fi
else
    check_fail "stow not found"
fi

# Check repository
section "Repository:"

cd "$EDEN_DIR" || check_fail "Cannot access Eden directory"

if [ -d "$EDEN_DIR/.git" ]; then
    check_pass "Eden git repository exists"
    
    if git diff-index --quiet HEAD -- 2>/dev/null; then
        check_pass "Repository is clean (no uncommitted changes)"
    else
        check_warn "Repository has uncommitted changes"
    fi
else
    check_fail "Not a git repository"
fi

# Check Eden directories and binaries
section "Eden Structure:"

# Check smart wrapper
if [ -f "$HOME/.local/bin/eden" ] && [ ! -L "$HOME/.local/bin/eden" ]; then
    check_pass "Eden wrapper installed at ~/.local/bin/eden"
else
    if [ -L "$HOME/.local/bin/eden" ]; then
        check_warn "Eden wrapper is a symlink (should be copied file)"
    else
        check_fail "Eden wrapper not found at ~/.local/bin/eden"
    fi
fi

# Check main implementation
if [ -f "$EDEN_DIR/bin/eden" ]; then
    check_pass "Eden CLI implementation at bin/eden"
else
    check_fail "Eden CLI missing at bin/eden"
fi

# Check ~/.eden structure
if [ -d "$HOME/.eden" ]; then
    check_pass "~/.eden directory exists"
    
    if [ -d "$HOME/.eden/libexec" ]; then
        LIBEXEC_COUNT=$(find "$HOME/.eden/libexec" -type f 2>/dev/null | wc -l)
        check_pass "~/.eden/libexec exists ($LIBEXEC_COUNT internal utilities)"
    else
        check_warn "~/.eden/libexec not found (may not be stowed yet)"
    fi
    
    if [ -d "$HOME/.eden/bin" ]; then
        BIN_COUNT=$(find "$HOME/.eden/bin" -type l 2>/dev/null | wc -l)
        check_pass "~/.eden/bin exists ($BIN_COUNT grafted binaries)"
    else
        check_warn "~/.eden/bin not found (no branch binaries grafted)"
    fi
    
    if GARDENS_REPO="$(eden_branches_repo)"; then
        check_pass "Gardens set up from $GARDENS_REPO"
    elif GARDENS_PROBLEM="$(eden_branches_repo_problem)"; then
        check_fail "$GARDENS_PROBLEM"
    elif eden_branch_list_exists; then
        check_pass "Branch tracking file exists"
    else
        check_warn "No branch tracking file (run 'eden graft' to set up)"
    fi
else
    check_warn "~/.eden directory not found (may not be stowed yet)"
fi

# Check git identity
section "Git Identity:"

GIT_IDENTITY_DIR="$HOME/.config/git/identities"
if [ -f "$GIT_IDENTITY_DIR/_default" ]; then
    GIT_NAME=$(git config --file "$GIT_IDENTITY_DIR/_default" user.name 2>/dev/null)
    if [ -n "$GIT_NAME" ] && [ "$GIT_NAME" != "Your Name" ]; then
        check_pass "Default git identity configured ($GIT_NAME)"
    else
        check_warn "Default git identity is a placeholder (edit _default or add one via a branch)"
    fi
else
    check_warn "No default git identity — add .config/git/identities/_default to a branch (see docs/branches-and-secrets.md)"
fi

# grep -c already prints "0" for no matches; `|| echo 0` would have appended
# a second "0", producing a multi-line value that breaks `[ -gt ]` below.
IDENTITY_COUNT=$(find "$GIT_IDENTITY_DIR" -type f -o -type l 2>/dev/null | grep -cv '_default' 2>/dev/null || true)
if [ "$IDENTITY_COUNT" -gt 0 ]; then
    check_pass "$IDENTITY_COUNT scoped git identity(ies) configured"
fi

# Interactive bash reads only ~/.bashrc, which Eden does not own (on
# Omarchy it is the distribution's template): it needs one line to load
# the env files that zsh gets from .zshenv.
if [ "${SHELL##*/}" = "bash" ]; then
    section "Shell:"
    if grep -Eq '^[^#]*(\.|source)[[:space:]].*\.config/bash/env' "$HOME/.bashrc" 2>/dev/null; then
        # shellcheck disable=SC2088  # the ~ is shown to the reader
        check_pass "~/.bashrc loads Eden's env files"
    else
        # shellcheck disable=SC2088  # the ~ is shown to the reader
        check_warn "~/.bashrc does not load Eden's env files; add: . ~/.config/bash/env"
    fi
fi

# Gardens: what .eden-gardens declares against what the repo holds and
# what this machine grows. A list read on every graft fails silently when
# it is wrong, so its mistakes are named here.
if GARDENS_REPO="$(eden_branches_repo)"; then
    section "Gardens:"
    GARDENS_FILE="$(eden_gardens_file)"
    GARDENS_ISSUES=0
    gardens_warn() {
        check_warn "$1"
        GARDENS_ISSUES=$((GARDENS_ISSUES + 1))
    }

    # Lines outside any section are never read.
    in_section=false
    while IFS= read -r line; do
        if [[ "$line" =~ ^\[[^]]+\]$ ]]; then
            in_section=true
        elif ! $in_section; then
            gardens_warn ".eden-gardens: '$line' comes before any [section] and is not read"
        fi
    done < <(eden_gardens_lines "$GARDENS_FILE")

    LISTED=$'\n'
    while IFS=$'\t' read -r g_section g_path g_platform; do
        g_rel="${g_path#"$GARDENS_REPO"/}"
        if [[ "$LISTED" == *$'\n'"$g_path"$'\n'* ]]; then
            check_fail ".eden-gardens lists $g_rel more than once; a branch belongs to one garden or to [shared]"
            GARDENS_ISSUES=$((GARDENS_ISSUES + 1))
        fi
        LISTED+="$g_path"$'\n'
        if [[ ! -d "$g_path" ]]; then
            gardens_warn ".eden-gardens lists $g_rel under [$g_section], which does not exist"
        elif [[ ! -f "$g_path/.eden-graft" ]]; then
            gardens_warn ".eden-gardens lists $g_rel, which is not a branch (no .eden-graft)"
        fi
        if [[ -n "$g_platform" && "$g_platform" != mac && "$g_platform" != arch ]]; then
            gardens_warn ".eden-gardens: $g_rel names platform '$g_platform'; it is grafted nowhere (mac or arch)"
        fi
    done < <(eden_gardens_entries)

    # A branch in the repo that no section lists grafts nothing.
    while IFS= read -r marker; do
        g_dir="$(dirname "$marker")"
        [[ "$g_dir" == "$GARDENS_REPO" ]] && continue
        [[ "$LISTED" == *$'\n'"$g_dir"$'\n'* ]] && continue
        inside=false
        while IFS= read -r g_path; do
            [[ -n "$g_path" && "$g_dir" == "$g_path"/* ]] && inside=true
        done <<< "$LISTED"
        $inside && continue
        LISTED+="$g_dir"$'\n'
        gardens_warn "${g_dir#"$GARDENS_REPO"/} is a branch that .eden-gardens does not list, so it grafts nothing"
    done < <(find -H "$GARDENS_REPO" -maxdepth 3 -name .git -prune -o -name .eden-graft -print 2>/dev/null | sort)

    DECLARED="$(eden_gardens_declared)"
    GROWN="$(eden_gardens_grown)"
    while IFS= read -r g_name; do
        [[ -n "$g_name" ]] || continue
        if [[ $'\n'"$DECLARED"$'\n' != *$'\n'"$g_name"$'\n'* ]]; then
            gardens_warn "This machine grows $g_name, which .eden-gardens does not declare: eden garden remove $g_name"
        fi
    done <<< "$GROWN"
    if [[ -z "$GROWN" ]]; then
        gardens_warn "This machine grows no garden, so only the shared branches graft: eden garden add <name>"
    elif ! IN_VIEW="$(eden_garden_in_view)"; then
        gardens_warn "No garden in view: eden garden use <name>"
    elif [[ $'\n'"$GROWN"$'\n' != *$'\n'"$IN_VIEW"$'\n'* ]]; then
        gardens_warn "$IN_VIEW is in view but not grown here: eden garden use <name>"
    fi
    if [[ -s "$(eden_branches_file)" ]]; then
        # shellcheck disable=SC2088  # the ~ is shown to the reader
        gardens_warn "~/.config/eden/branches is not read while gardens are set up; delete it"
    fi

    if (( GARDENS_ISSUES == 0 )); then
        check_pass "$(printf '%s' "$GROWN" | paste -sd' ' -) grown, $(eden_garden_in_view) in view; .eden-gardens matches the repo"
    fi
fi

# Check symlinks
section "Symlinks:"

# branch_root_of <path> — the nearest folder above path that carries a
# branch's .eden-graft, if any.
branch_root_of() {
    local d="$1"
    while [[ -n "$d" && "$d" != "/" ]]; do
        if [[ -f "$d/.eden-graft" ]]; then
            printf '%s\n' "$d"
            return 0
        fi
        d="$(dirname "$d")"
    done
    return 1
}

BROKEN=0
LEFTOVERS=0
if command -v find >/dev/null 2>&1; then
    # Compare resolved paths on both sides, so a symlink anywhere on the
    # way to a branch or the trunk does not make a match fail.
    REGISTERED=""
    while IFS= read -r branch_path; do
        REGISTERED+="$(cd "$branch_path" 2>/dev/null && pwd -P || printf '%s' "$branch_path")"$'\n'
    done < <(eden_graft_roots)
    EDEN_REAL="$(cd "$EDEN_ROOT" && pwd -P)"

    # Where grafts put links, and how deep: dir|maxdepth. ~/.config goes
    # three levels down, as deep as the deepest graft
    # (.config/spaces/spaces.d/<branch>.yaml). zshenv.d is listed on its
    # own for an XDG_CONFIG_HOME elsewhere; a link found twice is checked
    # once.
    link_scan() {
        local spec dir depth
        for spec in \
            "$HOME/.config|3" \
            "$HOME/.local/bin|2" \
            "$HOME/.eden/bin|1" \
            "$HOME/.claude|2" \
            "$HOME/.ssh|1" \
            "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/zshenv.d|1" \
            "$HOME/.config/git/identities|1"; do
            dir="${spec%|*}"
            depth="${spec##*|}"
            [ -d "$dir" ] || continue
            find "$dir" -maxdepth "$depth" -type l -print0 2>/dev/null
        done | sort -zu
    }
    while IFS= read -r -d '' link; do
        # Chromium and Electron apps mark a running profile with these
        # links; they point at host-pid, a number and a socket in /tmp,
        # so they dangle by design and are never grafts.
        case "${link##*/}" in SingletonLock|SingletonCookie|SingletonSocket) continue ;; esac
        if [ ! -e "$link" ]; then
            check_warn "Broken symlink: $link"
            BROKEN=$((BROKEN + 1))
            continue
        fi
        # A working link into a branch that is no longer registered:
        # what a removed branch left behind. The trunk carries its own
        # .eden-secrets, so links into it are not branch links.
        target="$(readlink -f "$link" 2>/dev/null)" || continue
        case "$target" in "$EDEN_REAL"/*) [[ "$target" == "$EDEN_REAL"/branches/* ]] || continue ;; esac
        root="$(branch_root_of "$target")" || continue
        [[ "$root" == "$EDEN_REAL" ]] && continue
        if ! grep -qxF "$root" <<< "$REGISTERED"; then
            check_warn "Link into an unregistered branch ($root): $link"
            LEFTOVERS=$((LEFTOVERS + 1))
        fi
    done < <(link_scan)

    if [ $BROKEN -eq 0 ]; then
        check_pass "No broken symlinks found"
    fi
    if [ $LEFTOVERS -eq 0 ]; then
        check_pass "No links into unregistered branches"
    fi
else
    check_warn "find command not available, skipping symlink check"
fi

# Check macOS services (yabai, skhd)
if [ "$(uname -s)" = "Darwin" ]; then
    section "Services:"

    for svc in yabai skhd; do
        if command -v "$svc" >/dev/null 2>&1; then
            if pgrep -x "$svc" >/dev/null 2>&1; then
                check_pass "$svc running"
            else
                check_warn "$svc installed but not running ($svc --start-service)"
            fi
        fi
    done

    if [ -d "/Applications/Karabiner-Elements.app" ]; then
        # Both namings: 15 and earlier ran karabiner_console_user_server
        # and karabiner_grabber, 16 renamed them Karabiner-Core-Service
        # and Karabiner-Console-User-Server. Matching only the first
        # warned that a running Karabiner was not running.
        if pgrep -f "[kK]arabiner[_-]" >/dev/null 2>&1; then
            check_pass "Karabiner running"
        else
            check_warn "Karabiner installed but not running"
        fi
    fi
fi

# Check package counts
section "Package Statistics:"

COMMON_COUNT=$(find "$EDEN_DIR/packages/common" -type f 2>/dev/null | wc -l)
EDEN_COUNT=$(find "$EDEN_DIR/packages/eden" -type f 2>/dev/null | wc -l)
ARCH_COUNT=$(find "$EDEN_DIR/packages/arch" -type f 2>/dev/null | wc -l)
MAC_COUNT=$(find "$EDEN_DIR/packages/mac" -type f 2>/dev/null | wc -l)

info_line "Files: $COMMON_COUNT in common, $EDEN_COUNT in eden, $ARCH_COUNT in arch, $MAC_COUNT in mac"

# Platform parity check
section "Platform Parity:"

# Check for duplicate paths between common and platform packages
OS=""
case "$(uname -s)" in
    Linux*) OS="arch" ;;
    Darwin*) OS="mac" ;;
esac

if [ -n "$OS" ]; then
    DUPLICATES=0
    while IFS= read -r file; do
        REL_PATH="${file#$EDEN_DIR/packages/common/}"
        if [ -f "$EDEN_DIR/packages/$OS/$REL_PATH" ]; then
            check_warn "Duplicate: $REL_PATH (in both common and $OS)"
            DUPLICATES=$((DUPLICATES + 1))
        fi
    done < <(find "$EDEN_DIR/packages/common" -type f 2>/dev/null)
    
    if [ $DUPLICATES -eq 0 ]; then
        check_pass "No duplicate files between common and $OS packages"
    fi
fi

# Branch coverage - detect ungrafted configs
section "Branch Coverage:"

# Discover covered paths dynamically from grafters (each supports --covers)
GRAFTER_PATTERNS=()
GRAFTERS_DIR="$EDEN_DIR/packages/eden/.eden/libexec/grafters"
if [ -d "$GRAFTERS_DIR" ]; then
    for grafter in "$GRAFTERS_DIR"/graft-*; do
        [ -x "$grafter" ] || continue
        if ! grep -q -- '--covers' "$grafter" 2>/dev/null; then
            check_warn "$(basename "$grafter"): missing --covers support"
            continue
        fi
        while IFS= read -r pattern; do
            [ -n "$pattern" ] && GRAFTER_PATTERNS+=("$pattern")
        done < <("$grafter" --covers 2>/dev/null)
    done
fi

is_covered_by_grafter() {
    local path="$1"
    for pattern in "${GRAFTER_PATTERNS[@]}"; do
        # Match exact path or anything under the pattern directory
        if [[ "$path" == "$pattern" || "$path" == "$pattern/"* ]]; then
            return 0
        fi
    done
    return 1
}

is_metadata() {
    local path="$1"
    # Skip eden metadata, docs, and root-level config files at branch root
    case "$path" in
        # platforms/ holds per-platform parts, each checked as a root of its own
        .eden-*|README.md|ARCHITECTURE.md|Brewfile|platforms) return 0 ;;
    esac
    return 1
}

if eden_branch_list_exists; then
    while IFS= read -r branch_path; do
        branch_name=$(eden_branch_name "$branch_path")

        if [[ ! -d "$branch_path" ]]; then
            check_warn "$branch_name: branch directory not found"
            continue
        fi

        # Collect graft allowlist entries
        declare -a graft_entries=()
        GRAFT_FILE="$branch_path/.eden-graft"
        if [[ -f "$GRAFT_FILE" ]]; then
            while IFS= read -r entry; do
                [[ -z "$entry" ]] && continue
                [[ "$entry" =~ ^[[:space:]]*# ]] && continue
                entry=$(echo "$entry" | xargs)
                graft_entries+=("$entry")
            done < "$GRAFT_FILE"
        fi

        is_in_graft_list() {
            local path="$1"
            for entry in "${graft_entries[@]}"; do
                if [[ "$path" == "$entry" || "$path" == "$entry/"* ]]; then
                    return 0
                fi
                # Also check if a parent of path is listed
                if [[ "$entry" == "$path/"* ]]; then
                    return 0
                fi
            done
            return 1
        }

        # Find all top-level config paths in the branch
        orphans=()
        # Check .config/ subdirectories
        if [[ -d "$branch_path/.config" ]]; then
            for item in "$branch_path/.config"/*; do
                [[ -e "$item" ]] || continue
                item_name=$(basename "$item")
                rel_path=".config/$item_name"

                if is_covered_by_grafter "$rel_path"; then
                    continue
                fi

                # For files nested deeper (e.g. .config/pnpm/rc), check individual files
                if [[ -d "$item" ]]; then
                    # Check if the directory or any parent path is in graft list
                    if is_in_graft_list "$rel_path"; then
                        continue
                    fi
                    # Check individual files within
                    while IFS= read -r subfile; do
                        sub_rel="${subfile#$branch_path/}"
                        if ! is_in_graft_list "$sub_rel" && ! is_covered_by_grafter "$sub_rel"; then
                            orphans+=("$sub_rel")
                        fi
                    done < <(find "$item" -type f 2>/dev/null)
                else
                    if ! is_in_graft_list "$rel_path"; then
                        orphans+=("$rel_path")
                    fi
                fi
            done
        fi

        # Check root-level non-metadata files
        for item in "$branch_path"/*; do
            [[ -e "$item" ]] || continue
            item_name=$(basename "$item")
            if is_metadata "$item_name"; then
                continue
            fi
            if ! is_covered_by_grafter "$item_name" && ! is_in_graft_list "$item_name"; then
                orphans+=("$item_name")
            fi
        done

        if [ ${#orphans[@]} -eq 0 ]; then
            check_pass "$branch_name: all configs covered"
        else
            check_warn "$branch_name: ungrafted configs found:"
            for orphan in "${orphans[@]}"; do
                info_line "  $orphan (not in .eden-graft, no dedicated grafter)"
            done
        fi

        unset graft_entries
    done < <(eden_graft_roots)
else
    info_line "No branches registered (skipping)"
fi

# Final result
section ""
if [ $ERRORS -gt 0 ]; then
    if [[ "$FORMAT" == "plain" ]]; then
        echo "summary|$ERRORS error(s), $WARNINGS warning(s)"
    else
        echo -e "${RED}✗ Found $ERRORS error(s), $WARNINGS warning(s)${NC}"
    fi
    exit 2
elif [ $WARNINGS -gt 0 ]; then
    if [[ "$FORMAT" == "plain" ]]; then
        echo "summary|0 errors, $WARNINGS warning(s)"
    else
        echo -e "${YELLOW}⚠ $WARNINGS warning(s) found${NC}"
    fi
    exit 1
else
    if [[ "$FORMAT" == "plain" ]]; then
        echo "summary|all checks passed"
    else
        echo -e "${GREEN}✓ Eden is healthy!${NC}"
    fi
    exit 0
fi

