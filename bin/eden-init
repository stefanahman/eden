#!/usr/bin/env bash
# eden-init — First-run setup.
#
# With a path to a repo that has a .eden-gardens, sets up gardens: records
# the repo, grows the gardens named with --garden (or asked for), grafts,
# and puts the first in view. A path without one is registered as a branch.
# Without a path, walks through registering a branch or scaffolding one.
# Then verifies the setup with eden doctor.
#
# Usage: eden init [<path>] [--garden <name>]... [--no-graft] [--yes|--no-prompt]
#
# Exit codes:
#   0  Setup complete (or cleanly skipped)
#   1  A garden could not be grown or grafting failed
#   2  Preflight or unknown arg

set -e

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

log()  { echo -e "${BLUE}→${NC} $1"; }
ok()   { echo -e "${GREEN}✓${NC} $1"; }
warn() { echo -e "${YELLOW}⚠${NC} $1"; }
err()  { echo -e "${RED}✗${NC} $1" >&2; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
EDEN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
# shellcheck source=lib/branches.sh
source "$EDEN_ROOT/lib/branches.sh"
BRANCHES_FILE="$(eden_branches_file)"

NO_PROMPT=false
GRAFT=true
INIT_PATH=""
GARDENS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --yes|--no-prompt|-y) NO_PROMPT=true; shift ;;
        --no-graft) GRAFT=false; shift ;;
        --garden)
            [ -n "${2:-}" ] || { err "--garden needs a name"; exit 2; }
            GARDENS+=("$2"); shift 2 ;;
        --garden=*) GARDENS+=("${1#*=}"); shift ;;
        -h|--help)
            sed -n '2,15p' "${BASH_SOURCE[0]}" | sed -E 's/^# ?//'
            exit 0
            ;;
        -*) err "Unknown arg: $1"; exit 2 ;;
        *)
            [ -z "$INIT_PATH" ] || { err "One path only: $1"; exit 2; }
            INIT_PATH="$1"; shift ;;
    esac
done

# Auto-detect non-interactive context (stdin not a tty)
[ -t 0 ] || NO_PROMPT=true

log "Eden init — first-run setup"
echo ""

# init_path <path> — a path from the command line, from where eden was run.
init_path() {
    local p
    p="$(eden_branch_expand "$1")"
    [[ "$p" == /* ]] || p="${EDEN_CALLER_PWD:-$PWD}/$p"
    [ -d "$p" ] && p="$(cd "$p" && pwd)"
    printf '%s\n' "$p"
}

run_doctor() {
    echo ""
    log "Verifying setup with 'eden doctor'…"
    set +e
    "$EDEN_ROOT/bin/eden-doctor"
    local status=$?
    set -e
    if [ $status -gt 0 ]; then
        warn "Doctor reported issues; review the output above."
    fi
}

# setup_gardens <repo> — the repo's gardens, as this machine grows them.
setup_gardens() {
    local repo="$1" declared garden reply here grown first failed=0
    mkdir -p "$(dirname "$(eden_branches_repo_file)")"
    printf '%s\n' "$repo" > "$(eden_branches_repo_file)"
    declared="$(eden_gardens_declared | paste -sd' ' -)"
    ok "Gardens from $repo/.eden-gardens: ${declared:-none declared yet}"

    if [ ${#GARDENS[@]} -eq 0 ] && [ -n "$declared" ]; then
        if $NO_PROMPT; then
            err "Name the gardens to grow here: --garden <name> (declared: $declared)"
            exit 2
        fi
        echo "Grow on this machine (space-separated, from: $declared):"
        read -r reply
        read -r -a GARDENS <<< "$reply"
    fi
    if [ ${#GARDENS[@]} -eq 0 ]; then
        warn "No gardens grown here: only the shared branches graft. Add one with: eden garden add <name>"
    fi
    for garden in ${GARDENS[@]+"${GARDENS[@]}"}; do
        "$EDEN_ROOT/bin/eden-garden" add "$garden" >/dev/null || exit 1
        ok "Growing $garden"
    done

    if [ -s "$BRANCHES_FILE" ]; then
        warn "$BRANCHES_FILE is no longer read while gardens are set up; delete it when you no longer need it"
    fi

    if $GRAFT; then
        echo ""
        log "Grafting…"
        "$EDEN_ROOT/bin/eden-graft" || failed=1
    fi

    # Keep the garden in view when this machine grows it; otherwise put the
    # first named one in view, or the first grown on a re-run.
    here="$(eden_garden_in_view)" || here=""
    grown="$(eden_gardens_grown)"
    if [ -n "$here" ] && grep -qxF -- "$here" <<< "$grown"; then
        ok "Garden in view: $here"
    else
        first="${GARDENS[0]:-${grown%%$'\n'*}}"
        if [ -n "$first" ]; then
            "$EDEN_ROOT/bin/eden-garden" use "$first" || failed=1
        fi
    fi

    run_doctor
    echo ""
    if [ $failed -gt 0 ]; then
        err "Init finished with errors; see above."
        exit 1
    fi
    ok "Init complete!"
    $GRAFT || echo "Next: eden graft"
    exit 0
}

if [ -n "$INIT_PATH" ]; then
    INIT_PATH="$(init_path "$INIT_PATH")"
    [ -d "$INIT_PATH" ] || { err "Directory does not exist: $INIT_PATH"; exit 2; }
    if [ -f "$INIT_PATH/.eden-gardens" ]; then
        setup_gardens "$INIT_PATH"
    fi
    [ ${#GARDENS[@]} -eq 0 ] || { err "No .eden-gardens in $INIT_PATH, so no gardens to grow"; exit 2; }
    log "No .eden-gardens in $INIT_PATH: registering it as a branch"
    "$EDEN_ROOT/bin/eden-branch" add "$INIT_PATH"
    run_doctor
    echo ""
    ok "Init complete!"
    echo "Next: eden graft"
    exit 0
fi

if [ ! -f "$BRANCHES_FILE" ]; then
    err "No branches file at $BRANCHES_FILE."
    err "Run ./install.sh from the Eden repo first."
    exit 2
fi

if $NO_PROMPT; then
    log "Non-interactive mode — skipping prompts."
    log "Use 'eden branch add <path>' or 'eden branch new <path>' to register branches later."
    ok "Init complete."
    exit 0
fi

# Q1: existing private branches?
echo "Do you have an existing private branches repo? [y/N]"
read -r reply
if [[ "$reply" =~ ^[Yy]$ ]]; then
    echo "Path to the repo with your .eden-gardens, or to one branch (e.g. ~/eden-branches/personal):"
    read -r path
    # From where eden was run, not EDEN_ROOT, where this script runs.
    [ -z "$path" ] || path="$(init_path "$path")"
    if [ -n "$path" ] && [ -f "$path/.eden-gardens" ]; then
        setup_gardens "$path"
    fi
    if [ -z "$path" ]; then
        warn "No path provided; skipping."
    elif [ ! -d "$path" ]; then
        warn "Directory does not exist: $path"
        warn "Run 'eden branch add $path' once it exists."
    else
        log "Registering branch: $path"
        "$EDEN_ROOT/bin/eden-branch" add "$path"
    fi
else
    echo ""
    echo "Create a new private branch now? [y/N]"
    read -r reply2
    if [[ "$reply2" =~ ^[Yy]$ ]]; then
        echo "Path for the new branch (e.g. ~/eden-branches/personal):"
        read -r newpath
        newpath="${newpath/#\~/$HOME}"
        if [ -n "$newpath" ]; then
            "$EDEN_ROOT/bin/eden-branch" new "$newpath"
        else
            warn "No path provided; skipping."
        fi
    else
        log "Skipped. You can register or create branches later with:"
        echo "    eden branch add <path>"
        echo "    eden branch new <path>"
    fi
fi

echo ""
log "Verifying setup with 'eden doctor'…"
set +e
"$EDEN_ROOT/bin/eden-doctor"
doctor_status=$?
set -e
if [ $doctor_status -gt 0 ]; then
    warn "Doctor reported issues; review the output above."
fi

echo ""
ok "Init complete!"
echo "Next steps:"
echo "  - eden graft   — apply your branch configs"
echo "  - eden help    — full command list"
