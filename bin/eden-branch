#!/bin/bash
# eden-branch - Manage Eden branches
# Branches are separate git repos for private, context-specific configurations
set -e

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
RESET='\033[0m'

log() {
    echo -e "${GREEN}▸${RESET} $1"
}

warn() {
    echo -e "${YELLOW}⚠${RESET} $1"
}

info() {
    echo -e "${BLUE}→${RESET} $1"
}

bold() {
    echo -e "${BOLD}$1${RESET}"
}

# Detect Eden root
detect_eden_root() {
    # Check if we're in the Eden repo
    local script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -f "$script_dir/../bin/eden" ]; then
        echo "$(cd "$script_dir/.." && pwd)"
    elif [ -d "$HOME/.eden" ]; then
        # Fallback: assume standard location
        echo "$HOME/eden"
    else
        echo "$HOME/eden"
    fi
}

EDEN_ROOT=$(detect_eden_root)

# shellcheck source=lib/branches.sh
source "$EDEN_ROOT/lib/branches.sh"
BRANCHES_FILE="$(eden_branches_file)"

# branch_arg_path <path> — the absolute path a command-line argument
# means: entry expansion (~, $EDEN_ROOT, $HOME), then relative to where
# eden was run (bin/eden runs this from EDEN_ROOT), resolved when the
# directory exists.
branch_arg_path() {
    local p
    p="$(eden_branch_expand "$1")"
    [[ "$p" == /* ]] || p="${EDEN_CALLER_PWD:-$PWD}/$p"
    if [[ -d "$p" ]]; then
        p="$(cd "$p" && pwd)"
    fi
    printf '%s\n' "$p"
}

# is_entry <line> — whether a line of the list is an entry, not a blank
# or a comment.
is_entry() {
    [[ ! "$1" =~ ^[[:space:]]*(#|$) ]]
}

# Gardens -------------------------------------------------------------------
# With gardens set up (eden init <repo>), the branches are the lines of the
# repo's .eden-gardens, not entries of the branches file: new, add, move
# and remove edit that file, and say which garden with --garden <name> or
# --shared, optionally --platform mac|arch.

GARDEN=""
PLATFORM=""
ARGS=()

gardens_on() {
    eden_branches_repo >/dev/null
}

trim() {
    local t="${1#"${1%%[![:space:]]*}"}"
    t="${t%"${t##*[![:space:]]}"}"
    # A trailing " # comment" is not part of the line, as eden reads it.
    if [[ "$t" =~ ^(.*[^[:space:]])[[:space:]]+#.*$ ]]; then
        t="${BASH_REMATCH[1]}"
    fi
    printf '%s\n' "$t"
}

# no_whitespace <path> — .eden-gardens splits a line on whitespace, so a
# folder name with any cannot be listed.
no_whitespace() {
    if [[ "$1" =~ [[:space:]] ]]; then
        warn "$1 has whitespace in its name, which .eden-gardens cannot hold" >&2
        exit 1
    fi
}

# parse_placement <args...> — takes out --garden, --shared and --platform,
# leaving the rest in ARGS.
parse_placement() {
    ARGS=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --garden)
                [[ -n "${2:-}" ]] || { warn "--garden needs a name"; exit 1; }
                GARDEN="$2"; shift 2 ;;
            --garden=*) GARDEN="${1#*=}"; shift ;;
            --shared) GARDEN=shared; shift ;;
            --platform)
                [[ -n "${2:-}" ]] || { warn "--platform needs mac or arch"; exit 1; }
                PLATFORM="$2"; shift 2 ;;
            --platform=*) PLATFORM="${1#*=}"; shift ;;
            *) ARGS+=("$1"); shift ;;
        esac
    done
    if [[ -n "$PLATFORM" && "$PLATFORM" != mac && "$PLATFORM" != arch ]]; then
        warn "Unknown platform: $PLATFORM (mac or arch)"
        exit 1
    fi
}

# require_placement — gardens need --garden or --shared; without gardens
# the options mean nothing.
require_placement() {
    if gardens_on; then
        if [[ -z "$GARDEN" ]]; then
            warn "Gardens are set up: say where the branch goes, --garden <name> or --shared"
            exit 1
        fi
        if [[ "$GARDEN" != shared ]] && ! grep -qxF -- "$GARDEN" <<< "$(eden_gardens_declared)"; then
            warn "No garden $GARDEN in $(eden_gardens_file); declare it with: eden garden new $GARDEN"
            exit 1
        fi
    elif [[ -n "$GARDEN" || -n "$PLATFORM" ]]; then
        warn "--garden, --shared and --platform need gardens: run eden init <repo>"
        exit 1
    fi
}

# repo_rel <path> — the path relative to the repo, which must hold it.
repo_rel() {
    local repo
    repo="$(eden_branches_repo)"
    case "$1" in
        "$repo")
            warn "The repo itself is not a branch" >&2
            exit 1 ;;
        "$repo"/*) printf '%s\n' "${1#"$repo"/}" ;;
        *)
            warn "$1 is outside $repo: a garden's branches live in its repo" >&2
            exit 1 ;;
    esac
}

# listed <path> — the section and platform the path is listed under, as
# section<TAB>platform, one per listing.
listed() {
    local section path platform
    while IFS=$'\t' read -r section path platform; do
        [[ "$path" == "$1" ]] && printf '%s\t%s\n' "$section" "$platform"
    done < <(eden_gardens_entries)
    return 0
}

# listed_path <arg> — the branch an argument names: a path from where eden
# was run, else a folder in the repo, else the one listed branch with that
# folder name.
listed_path() {
    local p matches
    p="$(branch_arg_path "$1")"
    if [[ -z "$(listed "$p")" ]]; then
        p="$(eden_branch_expand "$(eden_branches_repo)/$1")"
    fi
    if [[ -z "$(listed "$p")" ]]; then
        matches="$(eden_gardens_entries | cut -f2 | sort -u | while IFS= read -r p; do
            [[ "$(basename "$p")" == "$1" ]] && printf '%s\n' "$p"
        done)"
        if [[ -n "$matches" && "$(printf '%s\n' "$matches" | wc -l)" -gt 1 ]]; then
            warn "More than one branch is called $1; give its path: $(printf '%s\n' "$matches" | sed "s|^$(eden_branches_repo)/||" | paste -sd' ' -)" >&2
            exit 1
        fi
        p="$matches"
    fi
    if [[ -z "$p" || -z "$(listed "$p")" ]]; then
        warn "Not in $(eden_gardens_file): $1" >&2
        exit 1
    fi
    printf '%s\n' "$p"
}

write_lines() {
    local file="$1"
    shift
    if [[ $# -gt 0 ]]; then
        printf '%s\n' "$@" > "$file.tmp"
    else
        : > "$file.tmp"
    fi
    mv "$file.tmp" "$file"
}

# gardens_delete <path> — drops every line that names it.
gardens_delete() {
    local file repo line folder
    local -a out=()
    file="$(eden_gardens_file)"
    repo="$(eden_branches_repo)"
    while IFS= read -r line || [[ -n "$line" ]]; do
        if is_entry "$line" && [[ ! "$(trim "$line")" =~ ^\[ ]]; then
            read -r folder _ <<< "$line"
            folder="$(eden_branch_expand "$folder")"
            [[ "$folder" == /* ]] || folder="$repo/$folder"
            [[ "$folder" == "$1" ]] && continue
        fi
        out+=("$line")
    done < "$file"
    write_lines "$file" "${out[@]}"
}

# gardens_insert <section> <line> — adds the line after the section's last
# one; a missing [shared] is started at the top (gardens come from eden
# garden new).
gardens_insert() {
    local section="$1" entry="$2" file line current="" i header=-1 last=-1
    local -a lines=()
    file="$(eden_gardens_file)"
    while IFS= read -r line || [[ -n "$line" ]]; do
        lines+=("$line")
    done < "$file"
    for i in "${!lines[@]}"; do
        line="$(trim "${lines[$i]}")"
        if [[ "$line" =~ ^\[([^]]+)\]$ ]]; then
            current="${BASH_REMATCH[1]}"
            if [[ "$current" == "$section" && $header -lt 0 ]]; then
                header=$i
                last=$i
            fi
            continue
        fi
        if [[ "$current" == "$section" && $header -ge 0 && $last -ge $header ]] && is_entry "$line"; then
            last=$i
        fi
    done
    if (( header < 0 )); then
        lines=("[$section]" "$entry" "" "${lines[@]}")
    else
        lines=("${lines[@]:0:last+1}" "$entry" "${lines[@]:last+1}")
    fi
    write_lines "$file" "${lines[@]}"
}

# place <path> — lists the branch under GARDEN, with PLATFORM.
place() {
    local rel entry
    rel="$(repo_rel "$1")"
    no_whitespace "$rel"
    entry="$rel"
    [[ -n "$PLATFORM" ]] && entry="$rel  $PLATFORM"
    gardens_insert "$GARDEN" "$entry"
    log "Listed $rel under [$GARDEN] in $(eden_gardens_file)"
    if [[ "$GARDEN" != shared ]] && ! grep -qxF -- "$GARDEN" <<< "$(eden_gardens_grown)"; then
        info "This machine does not grow $GARDEN: eden garden add $GARDEN"
    fi
    info "Commit .eden-gardens, then run 'eden graft'"
}

move_branch() {
    local path where platform rel
    [[ -n "${1:-}" ]] || { warn "Usage: eden branch move <branch> --garden <name> | --shared [--platform mac|arch]"; exit 1; }
    gardens_on || { warn "move needs gardens: run eden init <repo>"; exit 1; }
    require_placement
    path="$(listed_path "$1")"
    where="$(listed "$path")"
    where="${where%%$'\n'*}"
    platform="${where#*$'\t'}"
    [[ -n "$PLATFORM" ]] || PLATFORM="$platform"
    # Check the new place before touching the file, so a branch that
    # cannot be placed keeps its line.
    rel="$(repo_rel "$path")" || exit 1
    no_whitespace "$rel"
    gardens_delete "$path"
    place "$path"
}

list_gardens() {
    local repo here grown section path platform current="" mark note
    repo="$(eden_branches_repo)"
    here="$(eden_platform)" || here=""
    grown="$(eden_gardens_grown)"
    bold "Branches in $(eden_gardens_file)"
    while IFS=$'\t' read -r section path platform; do
        if [[ "$section" != "$current" ]]; then
            current="$section"
            echo ""
            if [[ "$section" == shared ]]; then
                echo "[shared]"
            elif [[ "$(eden_garden_in_view 2>/dev/null)" == "$section" ]]; then
                echo "[$section]  in view"
            elif grep -qxF -- "$section" <<< "$grown"; then
                echo "[$section]  grown"
            else
                echo "[$section]  not grown here"
            fi
        fi
        note=""
        [[ -n "$platform" ]] && note=" ($platform)"
        if [[ ! -d "$path" ]]; then
            mark="✗"; note="$note, not found"
        elif grep -qxF -- "$path" <<< "$(eden_branches)"; then
            mark="✓"
        else
            mark="·"
        fi
        echo "  $mark ${path#"$repo"/}$note"
    done < <(eden_gardens_entries)
    echo ""
    info "✓ grafted here, · not grafted here"
}

# Show help
show_help() {
    bold "Eden Branch Management"
    echo ""
    echo "Usage: eden branch <command> [options]"
    echo ""
    echo "Commands:"
    echo "  add <path>       Register an existing branch"
    echo "  new <path>       Create and register a new branch"
    echo "  move <branch>    Move a branch to another garden (gardens only)"
    echo "  list             List all registered branches"
    echo "  remove <path>    Unregister a branch"
    echo ""
    echo "With gardens (eden init <repo>), add, new, move and remove edit the"
    echo "repo's .eden-gardens and take where the branch goes:"
    echo "  --garden <name>  in that garden"
    echo "  --shared         in every garden"
    echo "  --platform <p>   on mac or arch only"
    echo "  help             Show this help message"
    echo ""
    echo "Examples:"
    echo "  eden branch new ~/branch-work"
    echo "  eden branch add ~/existing-branch"
    echo "  eden branch new branches/hobby --garden personal"
    echo "  eden branch list"
    echo ""
    echo "Branches extend Eden with private configurations:"
    echo "  • Structure mirrors HOME directory (~/) for consistency"
    echo "  • Can contain .eden-secrets, binaries, configs, MCP servers"
    echo "  • Use 'eden graft' to integrate branch configs into Eden"
    echo ""
    echo "See docs/branches-and-secrets.md for more information"
}

# Add a branch
add_branch() {
    local branch_path="$1"
    
    if [ -z "$branch_path" ]; then
        warn "Usage: eden branch add <path>"
        exit 1
    fi
    
    branch_path="$(branch_arg_path "$branch_path")"
    require_placement

    # Check if directory exists
    if [ ! -d "$branch_path" ]; then
        warn "Directory does not exist: $branch_path"
        echo ""
        echo "Create it first with:"
        echo "  mkdir -p $branch_path"
        echo "  cd $branch_path && git init"
        echo ""
        echo "Or use: eden branch init $branch_path"
        exit 1
    fi
    
    if gardens_on; then
        local where
        where="$(listed "$branch_path" | cut -f1 | paste -sd' ' -)"
        if [[ -n "$where" ]]; then
            warn "Already listed under [$where]; to change that: eden branch move"
            exit 0
        fi
        place "$branch_path"
        return 0
    fi

    # Create branches file if it doesn't exist
    mkdir -p "$(dirname "$BRANCHES_FILE")"
    touch "$BRANCHES_FILE"
    
    # Already registered: an entry that expands to the same path, compared
    # whole — /x/a is not /x/a-b.
    local entry
    while IFS= read -r entry; do
        if [[ "$entry" == "$branch_path" ]]; then
            warn "Branch already registered: $branch_path"
            exit 0
        fi
    done < <(eden_branches)

    # Add on a line of its own, even when the last line has no newline.
    if [[ -s "$BRANCHES_FILE" && -n "$(tail -c 1 "$BRANCHES_FILE")" ]]; then
        echo >> "$BRANCHES_FILE"
    fi
    echo "$branch_path" >> "$BRANCHES_FILE"

    log "Branch registered: $branch_path"

    # Auto-deactivate the example branch when the user adds their own branch —
    # the example is a starter; it shouldn't keep shadowing real configs.
    if grep -qE '^\$EDEN_ROOT/branches/example[[:space:]]*$' "$BRANCHES_FILE"; then
        # Portable in-place edit (works on BSD and GNU sed)
        sed -i.bak -E 's|^\$EDEN_ROOT/branches/example[[:space:]]*$|# $EDEN_ROOT/branches/example  (auto-deactivated — you have your own branches now)|' "$BRANCHES_FILE"
        rm -f "$BRANCHES_FILE.bak"
        info "Example branch deactivated in $BRANCHES_FILE"
    fi

    echo ""
    info "Next steps:"
    echo "  1. Add configs to the branch (see docs/branches-and-secrets.md)"
    echo "  2. Run 'eden graft' to integrate branch configs"
}

# List branches
list_branches() {
    if gardens_on; then
        list_gardens
        return 0
    fi
    if [ ! -f "$BRANCHES_FILE" ]; then
        warn "No branches registered"
        echo ""
        echo "Register a branch with: eden branch add <path>"
        exit 0
    fi
    
    bold "Registered Branches"
    echo ""
    
    local count=0
    while IFS= read -r branch_path || [ -n "$branch_path" ]; do
        # Skip empty lines and comments
        [[ -z "$branch_path" || "$branch_path" =~ ^[[:space:]]*# ]] && continue
        
        # Expand variables and tilde for display
        local display_path=$(eden_branch_expand "$branch_path")
        
        count=$((count + 1))
        
        # Check if directory exists
        if [ -d "$display_path" ]; then
            # Show original path (with variables) for readability
            echo "  ✓ $branch_path"
            
            # Show git status if it's a git repo
            if [ -d "$display_path/.git" ]; then
                local branch=$(cd "$display_path" && git branch --show-current 2>/dev/null || echo "unknown")
                echo "    Git: $branch"
            fi
            
            # Show if it has secrets
            if [ -f "$display_path/.eden-secrets" ]; then
                # grep -c prints 0 and exits 1 when nothing matches, so
                # `|| echo 0` would print a second 0.
                local secret_count
                secret_count=$(grep -c "^\[secret\]" "$display_path/.eden-secrets" 2>/dev/null) || true
                echo "    Secrets: ${secret_count:-0} defined"
            fi
            
            # Show if it has MCP configs
            if [ -f "$display_path/.config/mcp/servers.json" ]; then
                echo "    MCP: config found"
            fi

            # Show its platform folders, and which one this machine grafts
            if [ -d "$display_path/platforms" ]; then
                local platform here names=""
                here="$(eden_platform)" || here=""
                for platform in "$display_path/platforms"/*/; do
                    [ -d "$platform" ] || continue
                    platform="$(basename "$platform")"
                    [ "$platform" = "$here" ] && platform="$platform (grafted here)"
                    names="${names:+$names, }$platform"
                done
                [ -n "$names" ] && echo "    Platforms: $names"
            fi
        else
            echo "  ✗ $branch_path (not found)"
        fi
        echo ""
    done < "$BRANCHES_FILE"
    
    if [ $count -eq 0 ]; then
        warn "No branches registered"
        echo ""
        echo "Register a branch with: eden branch add <path>"
    else
        echo "Total: $count branch(es)"
        echo ""
        info "Run 'eden graft' to integrate branch configs"
    fi
}

# Remove a branch
remove_branch() {
    local branch_path="$1"
    
    if [ -z "$branch_path" ]; then
        warn "Usage: eden branch remove <path>"
        exit 1
    fi
    
    if gardens_on; then
        branch_path="$(listed_path "$branch_path")"
        gardens_delete "$branch_path"
        log "Took ${branch_path#"$(eden_branches_repo)"/} out of $(eden_gardens_file)"
        info "The folder stays, and what it grafted stays until removed by hand; eden doctor reports it"
        return 0
    fi

    if [ ! -f "$BRANCHES_FILE" ]; then
        warn "No branches registered"
        exit 1
    fi
    
    branch_path="$(branch_arg_path "$branch_path")"

    # Keep every line except the entries that expand to this path, compared
    # whole; comments and blank lines stay as they are.
    local line removed=0
    local -a kept=()
    while IFS= read -r line || [[ -n "$line" ]]; do
        if is_entry "$line" && [[ "$(eden_branch_expand "$line")" == "$branch_path" ]]; then
            removed=$((removed + 1))
            continue
        fi
        kept+=("$line")
    done < "$BRANCHES_FILE"

    if (( removed == 0 )); then
        warn "Branch not found in registry: $branch_path"
        exit 1
    fi

    if (( ${#kept[@]} > 0 )); then
        printf '%s\n' "${kept[@]}" > "$BRANCHES_FILE.tmp"
    else
        : > "$BRANCHES_FILE.tmp"
    fi
    mv "$BRANCHES_FILE.tmp" "$BRANCHES_FILE"

    log "Branch unregistered: $branch_path"
    echo ""
    info "The directory still exists. Remove it manually if needed:"
    echo "  rm -rf $branch_path"
}

# Create a new branch
new_branch() {
    local branch_path="$1"
    
    if [ -z "$branch_path" ]; then
        warn "Usage: eden branch new <path>"
        exit 1
    fi
    
    branch_path="$(branch_arg_path "$branch_path")"
    require_placement
    if gardens_on; then
        local rel
        rel="$(repo_rel "$branch_path")" || exit 1
        no_whitespace "$rel"
    fi
    
    local branch_name=$(basename "$branch_path")
    
    log "Initializing branch: $branch_name"
    echo ""
    
    # Create directory
    if [ -d "$branch_path" ]; then
        warn "Directory already exists: $branch_path"
    else
        mkdir -p "$branch_path"
        info "Created directory: $branch_path"
    fi
    
    
    # Create basic structure
    mkdir -p "$branch_path/.config/eden/local"
    mkdir -p "$branch_path/.local/bin"
    
    # Create README
    if [ ! -f "$branch_path/README.md" ]; then
        cat > "$branch_path/README.md" << EOF
# Eden Branch: $branch_name

Private configuration branch for Eden.

## Contents

- \`.eden-secrets\`: Secret requirements for 1Password
- \`.config/eden/local/\`: Configuration files (git, etc.)
- \`.local/bin/\`: Branch-specific scripts

## Usage

Register this branch with Eden:

\`\`\`bash
eden branch add $branch_path
eden graft
\`\`\`

## Structure

\`\`\`
$branch_name/
├── .eden-secrets              # Secret definitions
├── .config/
│   ├── mcp/
│   │   └── servers.json      # MCP server configs (client-agnostic)
│   └── eden/
│       └── local/
│           └── gitconfig.$branch_name  # Git config for this context
└── .local/
    └── bin/                   # Branch-specific scripts
\`\`\`

Note: Branch structure mirrors HOME directory (~/) for consistency.

See [branches-and-secrets.md](https://github.com/yourusername/eden/blob/main/docs/branches-and-secrets.md) for more info.
EOF
        info "Created README.md"
    fi
    
    # Create .gitignore
    if [ ! -f "$branch_path/.gitignore" ]; then
        cat > "$branch_path/.gitignore" << 'EOF'
# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Backup files
*~
*.swp
*.bak
EOF
        info "Created .gitignore"
    fi
    
    # Create sample .eden-secrets
    if [ ! -f "$branch_path/.eden-secrets" ]; then
        cat > "$branch_path/.eden-secrets" << EOF
# Eden Secrets for $branch_name
# Define 1Password requirements for this branch

# Example:
# [secret]
# name=Example Secret
# path=op://Private/Example/password
# description=Example secret for $branch_name
# required_by=Some application or script
# setup_command=example-setup
EOF
        info "Created .eden-secrets template"
    fi
    
    # Register the branch
    add_branch "$branch_path"
    
    echo ""
    log "Branch created and registered!"
    echo ""
    info "Next steps:"
    echo "  1. cd $branch_path"
    echo "  2. Add your private configs (MCP, secrets, binaries, etc.)"
    echo "  3. Run 'eden graft' to integrate the branch"
    echo ""
    info "💡 Tip: Use git to version control this branch"
}

# Main
main() {
    local command="${1:-help}"
    shift || true
    parse_placement "$@"
    set -- ${ARGS[@]+"${ARGS[@]}"}
    
    case "$command" in
        add)
            add_branch "$@"
            ;;
        move|mv)
            move_branch "$@"
            ;;
        list|ls)
            list_branches "$@"
            ;;
        remove|rm)
            remove_branch "$@"
            ;;
        new|create)
            new_branch "$@"
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            warn "Unknown command: $command"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

main "$@"

