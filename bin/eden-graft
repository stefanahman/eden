#!/bin/bash
# Eden graft - Graft branch configs into Eden
# Auto-discovers configs from branch repos and grafts them into local configs
#
# Usage:
#   eden graft          Run all grafters
#   eden graft git      Run only graft-git
#   eden graft --list   List available grafters
set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log() {
    echo -e "${GREEN}▸${NC} $1"
}

warn() {
    echo -e "${YELLOW}⚠${NC} $1"
}

err() {
    echo -e "${RED}✗${NC} $1" >&2
}

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
EDEN_ROOT="${EDEN_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}"

# shellcheck source=lib/branches.sh
source "$EDEN_ROOT/lib/branches.sh"
BRANCHES_FILE="$(eden_branches_file)"

# Grafter contract version. Bump when changing how grafters are invoked,
# discovered, or what env vars they may rely on — not for optional additions.
# See CLAUDE.md "Versioning" section.
EDEN_GRAFTER_API_CURRENT=1

# Get the API version a grafter declares (defaults to 1 if no --api-version handler).
get_grafter_api() {
    local declared
    declared=$(bash "$1" --api-version 2>/dev/null || echo 1)
    echo "${declared:-1}"
}

# Refuse to run a grafter that declares a different API version.
check_grafter_compat() {
    local grafter="$1" declared
    declared=$(get_grafter_api "$grafter")
    if [[ "$declared" != "$EDEN_GRAFTER_API_CURRENT" ]]; then
        err "$(basename "$grafter") declares API v$declared; runner is v$EDEN_GRAFTER_API_CURRENT"
        err "Update the grafter or pin Eden to a compatible version."
        return 1
    fi
}

# Check if a branch list is set up
if ! eden_branch_list_exists; then
    warn "No branches file found at $BRANCHES_FILE"
    echo "  Run ./install.sh first"
    exit 1
fi

# Resolve grafters directory
resolve_grafters_dir() {
    local dir="$HOME/.eden/libexec/grafters"
    if [ ! -d "$dir" ]; then
        dir="$SCRIPT_DIR/../packages/eden/.eden/libexec/grafters"
    fi
    if [ ! -d "$dir" ]; then
        warn "Grafters directory not found. Run 'eden plant' first."
        return 1
    fi
    echo "$dir"
}

# List available grafters
list_grafters() {
    local grafters_dir
    grafters_dir=$(resolve_grafters_dir) || exit 1

    echo "Available grafters:"
    echo ""
    for grafter in "$grafters_dir"/graft-*; do
        [ -e "$grafter" ] || continue
        [ -x "$grafter" ] || continue
        local name
        name=$(basename "$grafter" | sed 's/^graft-//')
        echo "  $name"
    done
}

# Run a single grafter by name
run_single_grafter() {
    local name="$1"
    local grafters_dir
    grafters_dir=$(resolve_grafters_dir) || exit 1

    local grafter="$grafters_dir/graft-$name"
    if [ ! -f "$grafter" ]; then
        err "Unknown grafter: $name"
        echo ""
        list_grafters
        exit 1
    fi
    if [ ! -x "$grafter" ]; then
        err "Grafter not executable: graft-$name"
        exit 1
    fi

    check_grafter_compat "$grafter" || exit 1

    log "Running: graft-$name"
    local rc=0
    bash "$grafter" || rc=$?
    if [ $rc -eq 0 ]; then
        log "graft-$name complete"
    else
        warn "graft-$name failed (exit code: $rc)"
        exit 1
    fi
}

# Run all grafters
run_all_grafters() {
    local grafters_dir
    grafters_dir=$(resolve_grafters_dir) || exit 1

    log "Running pluggable grafters..."
    echo ""

    # Every grafter runs even when one fails, so the report is complete;
    # the run fails if any of them did.
    local ran=0 rc grafter_name
    local -a failed=()
    for grafter in "$grafters_dir"/graft-*; do
        [ -e "$grafter" ] || continue
        [ -x "$grafter" ] || continue

        grafter_name=$(basename "$grafter")

        if ! check_grafter_compat "$grafter"; then
            failed+=("$grafter_name (incompatible API)")
            echo ""
            continue
        fi

        log "Running: $grafter_name"

        rc=0
        bash "$grafter" || rc=$?
        if [ "$rc" -eq 0 ]; then
            ran=$((ran + 1))
        else
            warn "$grafter_name failed (exit code: $rc)"
            failed+=("$grafter_name")
        fi
        echo ""
    done

    if [ "$ran" -eq 0 ] && [ "${#failed[@]}" -eq 0 ]; then
        warn "No grafters found in $grafters_dir"
        return 1
    fi

    if [ "${#failed[@]}" -gt 0 ]; then
        err "Failed: ${failed[*]}"
        return 1
    fi

    return 0
}

# =============================================================================
# MAIN
# =============================================================================
main() {
    # --force reaches every grafter as EDEN_GRAFT_FORCE=true: apply
    # without prompting (for non-interactive runs). It may come before or
    # after a grafter name.
    local -a args=()
    local arg
    for arg in "$@"; do
        if [[ "$arg" == "--force" ]]; then
            export EDEN_GRAFT_FORCE=true
        else
            args+=("$arg")
        fi
    done
    set -- "${args[@]}"

    case "${1:-}" in
        --list|-l)
            list_grafters
            ;;
        --help|-h)
            echo "Usage: eden graft [name] [--list] [--force]"
            echo ""
            echo "  eden graft          Run all grafters"
            echo "  eden graft git      Run only graft-git"
            echo "  eden graft --list   List available grafters"
            echo "  eden graft --force  Apply without prompting"
            ;;
        "")
            log "Grafting branch configs into Eden..."
            echo ""
            if run_all_grafters; then
                echo ""
                log "Graft complete!"
            else
                echo ""
                warn "Graft completed with errors"
                exit 1
            fi
            ;;
        -*)
            err "Unknown flag: $1"
            echo "Run 'eden graft --help' for usage"
            exit 1
            ;;
        *)
            run_single_grafter "$1"
            ;;
    esac
}

main "$@"
